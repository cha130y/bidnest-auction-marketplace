digraph bidnest_erd {
  rankdir=LR;
  bgcolor="white";
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#8899aa", arrowsize=0.7];
  graph [fontname="Helvetica", fontsize=20, label="BidNest — Auction & Marketplace  ER Diagram v1", labelloc=t, labeljust=l];

  subgraph cluster_Identity {
    label="Identity";
    fontsize=16; fontcolor="#2f6f4f"; color="#2f6f4f"; style=rounded; margin=16;
    users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="email">email : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="role">role : user_role</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : user_status</TD></TR><TR><TD ALIGN="LEFT" PORT="email_verified_at">email_verified_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_at">last_login_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at : timestamp</TD></TR></TABLE>>];
    user_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>user_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">&#128273; user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="display_name">display_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="avatar_url">avatar_url : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="bio">bio : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="location">location : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="default_shipping_address">default_shipping_address : text</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at : timestamp</TD></TR></TABLE>>];
    auth_accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>auth_accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="provider">provider : auth_provider</TD></TR><TR><TD ALIGN="LEFT" PORT="provider_account_id">provider_account_id : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    user_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>user_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="refresh_token_hash">refresh_token_hash : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="revoked_at">revoked_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    two_factor_codes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>two_factor_codes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="code_hash">code_hash : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="used">used : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    password_reset_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#2f6f4f" ALIGN="LEFT"><FONT COLOR="white"><B>password_reset_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="token_hash">token_hash : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="used">used : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
  }

  subgraph cluster_Shared {
    label="Shared";
    fontsize=16; fontcolor="#7a5c00"; color="#7a5c00"; style=rounded; margin=16;
    categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a5c00" ALIGN="LEFT"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id">parent_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="slug">slug : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="created_by_admin_id">created_by_admin_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at : timestamp</TD></TR></TABLE>>];
  }

  subgraph cluster_Auction {
    label="Auction";
    fontsize=16; fontcolor="#1f3864"; color="#1f3864"; style=rounded; margin=16;
    auctions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#1f3864" ALIGN="LEFT"><FONT COLOR="white"><B>auctions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id">seller_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">category_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="title">title : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="condition">condition : product_condition</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : auction_status</TD></TR><TR><TD ALIGN="LEFT" PORT="currency">currency : char</TD></TR><TR><TD ALIGN="LEFT" PORT="starting_price">starting_price : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="reserve_price">reserve_price : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="min_bid_increment">min_bid_increment : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="current_price">current_price : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_count">bid_count : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_start_at">scheduled_start_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="original_end_at">original_end_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="current_end_at">current_end_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="published_at">published_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">started_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at">ended_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="extension_count">extension_count : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="winner_user_id">winner_user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="winning_bid_id">winning_bid_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="sold_price">sold_price : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="cancellation_reason">cancellation_reason : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="row_version">row_version : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at">deleted_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at : timestamp</TD></TR></TABLE>>];
    auction_images [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#1f3864" ALIGN="LEFT"><FONT COLOR="white"><B>auction_images</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="auction_id">auction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="storage_key">storage_key : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="url">url : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="alt_text">alt_text : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="position">position : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="is_primary">is_primary : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    bids [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#1f3864" ALIGN="LEFT"><FONT COLOR="white"><B>bids</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="auction_id">auction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="bidder_id">bidder_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="sequence_no">sequence_no : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="client_request_id">client_request_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="placed_at">placed_at : timestamp</TD></TR></TABLE>>];
    auction_extensions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#1f3864" ALIGN="LEFT"><FONT COLOR="white"><B>auction_extensions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="auction_id">auction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="triggered_by_bid_id">triggered_by_bid_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="extension_number">extension_number : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="previous_end_at">previous_end_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="new_end_at">new_end_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    auction_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#1f3864" ALIGN="LEFT"><FONT COLOR="white"><B>auction_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="auction_id">auction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="actor_user_id">actor_user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_id">bid_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="event_type">event_type : auction_event_type</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
  }

  subgraph cluster_Ecommerce {
    label="Ecommerce";
    fontsize=16; fontcolor="#7a2e2e"; color="#7a2e2e"; style=rounded; margin=16;
    products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id">seller_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">category_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="title">title : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="price">price : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="stock_qty">stock_qty : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="condition">condition : product_condition</TD></TR><TR><TD ALIGN="LEFT" PORT="negotiation_floor">negotiation_floor : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_discount_min_qty">quantity_discount_min_qty : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_discount_percent">quantity_discount_percent : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : product_status</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at : timestamp</TD></TR></TABLE>>];
    product_images [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>product_images</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="storage_key">storage_key : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="url">url : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="alt_text">alt_text : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="position">position : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="is_primary">is_primary : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    carts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>carts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    cart_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>cart_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="cart_id">cart_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity : integer</TD></TR></TABLE>>];
    offers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>offers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_id">buyer_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="offer_amount">offer_amount : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="decision">decision : offer_decision</TD></TR><TR><TD ALIGN="LEFT" PORT="counter_amount">counter_amount : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="checkout_session_id">checkout_session_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id">seller_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_id">buyer_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="payment_transaction_id">payment_transaction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="subtotal">subtotal : decimal</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : order_status</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    order_addresses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>order_addresses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="recipient_name">recipient_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="line1">line1 : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="line2">line2 : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="city">city : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="postal_code">postal_code : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone : varchar</TD></TR></TABLE>>];
    order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price : decimal</TD></TR></TABLE>>];
    payment_transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>payment_transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="checkout_session_id">checkout_session_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : payment_status</TD></TR><TR><TD ALIGN="LEFT" PORT="method">method : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    conversations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>conversations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_id">buyer_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id">seller_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>messages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id">conversation_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="sender_id">sender_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="body">body : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR><TR><TD ALIGN="LEFT" PORT="read_at">read_at : timestamp</TD></TR></TABLE>>];
    shipments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>shipments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="tracking_number">tracking_number : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="carrier">carrier : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status : shipment_status</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
    shipment_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#7a2e2e" ALIGN="LEFT"><FONT COLOR="white"><B>shipment_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">&#128273; id : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="shipment_id">shipment_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="actor_user_id">actor_user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="event_type">event_type : shipment_status</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
  }

  subgraph cluster_Engagement {
    label="Engagement";
    fontsize=16; fontcolor="#4b2e7a"; color="#4b2e7a"; style=rounded; margin=16;
    watchlists [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cccccc"><TR><TD BGCOLOR="#4b2e7a" ALIGN="LEFT"><FONT COLOR="white"><B>watchlists</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">&#128273; user_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="auction_id">&#128273; auction_id : uuid</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at : timestamp</TD></TR></TABLE>>];
