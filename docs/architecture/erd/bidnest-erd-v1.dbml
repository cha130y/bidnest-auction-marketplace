
enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum auth_provider {
  GOOGLE
  LINE
}

enum auction_status {
  DRAFT
  SCHEDULED
  ACTIVE
  SOLD
  UNSOLD
  CANCELLED
}

enum participant_status {
  JOINED
  LEFT
}

enum notification_type {
  OUTBID
  AUCTION_WON
  AUCTION_ENDED
  AUCTION_CANCELLED
  ORDER_PLACED // — NOT-005
  SHIPMENT_UPDATE // — NOT-006
  DELIVERED // — NOT-007
  NEW_MESSAGE // — NOT-008 (Optional)
}

enum auction_event_type {
  CREATED
  PUBLISHED
  STARTED
  BID_PLACED
  EXTENDED
  ENDED
  CANCELLED
}

enum admin_action_type {
  SUSPEND_USER
  REACTIVATE_USER
  CREATE_CATEGORY
  UPDATE_CATEGORY
  ACTIVATE_CATEGORY
  DEACTIVATE_CATEGORY
  CANCEL_AUCTION
  DEACTIVATE_PRODUCT // — ADM-005
  REACTIVATE_PRODUCT // New
}

// -- Additional --

enum product_condition {
  NEW
  USED
}

enum product_status {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  REMOVED
  SUSPENDED // new — ADM-005 (set by an admin only; the seller cannot move out of it — ADR-0002)
}

enum offer_decision {
  ACCEPTED
  COUNTERED
  REJECTED
}

enum order_status {
  PENDING
  PAID
  CANCELLED
}

enum payment_status {
  SUCCEEDED
  FAILED
}

enum shipment_status {
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ai_request_type {
  PRICE_ESTIMATE
  NEGOTIATION
}

enum chat_role {
  USER
  ASSISTANT
  ADMIN // — AI-001 answered by the Admin who took over from the AI
}

enum support_session_status {
  AI_ONLY // — default, still talking to the AI
  ESCALATED // — handed over to an Admin; the AI is no longer called
  RESOLVED
}

// ============ IDENTITY ============

Table users {
  id uuid [pk]
  email varchar [unique, not null]
  password_hash varchar [note: 'nullable — OAuth-only accounts have no password']
  role user_role [not null, default: 'USER']
  status user_status [not null, default: 'ACTIVE']
  email_verified_at timestamp [note: 'nullable — stamped when Google/Line verifies the email for us; we run no verification flow of our own']
  last_login_at timestamp
  auto_reply_message varchar [note: 'nullable — automatic reply message of the seller, at most 500 characters; empty means disabled (CHAT-004)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (role, status)
  }

  Note: 'AUTH-001, ADM-002'
}

Table user_profiles {
  user_id uuid [pk]
  first_name varchar [not null]
  last_name varchar
  display_name varchar [not null]
  avatar_url varchar
  bio varchar
  phone varchar [note: 'default shipping address — the same 6 fields as order_addresses']
  recipient_name varchar
  line1 varchar
  line2 varchar
  city varchar
  postal_code varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (display_name)
  }

  Note: 'USR-001 — user_id is both PK and FK. The default shipping address is stored as 6 separate fields whose names and widths match order_addresses exactly, so checkout (CART-004) can prefill from it directly without a converter — the only difference is that every field here is nullable, while those on the order are required, because that is the snapshot the parcel was actually sent to. It used to be location + default_shipping_address (one free-text blob), which could not be prefilled'
}

Table auth_accounts {
  id uuid [pk]
  user_id uuid [not null]
  provider auth_provider [not null]
  provider_account_id varchar [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (provider, provider_account_id) [unique]
    (user_id, provider) [unique]
  }

  Note: 'AUTH-003 Google, AUTH-006 Line'
}

Table user_sessions {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token_hash varchar [unique, not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, expires_at)
    (expires_at)
  }

  Note: 'AUTH-004'
}

Table two_factor_codes {
  id uuid [pk]
  user_id uuid [not null]
  code_hash varchar [not null]
  expires_at timestamp [not null]
  used boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Note: 'new — AUTH-007'
}

Table trusted_devices {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [unique, not null, note: 'SHA-256 of the token the browser keeps; the token itself is not stored']
  label varchar [note: 'nullable — device label, at most 200 characters']
  expires_at timestamp [not null]
  last_used_at timestamp [not null, default: `now()`]
  revoked_at timestamp [note: 'nullable — when this device stopped being trusted; a password reset (AUTH-005) revokes all rows of that user']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, expires_at)
    (expires_at)
  }

  Note: 'new — AUTH-007: a browser that has already answered the code correctly skips the code on later logins until it expires (30 days by default). It replaces only the second factor, never the password'
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [not null]
  expires_at timestamp [not null]
  used boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Note: 'new — AUTH-005'
}

// ============ SHARED ============

Table categories {
  id uuid [pk]
  parent_id uuid [note: 'used on the auction side for subcategories; can be left empty if unused']
  name varchar [not null]
  slug varchar [unique, not null]
  description varchar
  is_active boolean [not null, default: true]
  created_by_admin_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (parent_id, is_active)
    (is_active)
  }

  Note: 'ADM-003 — shared by both Auction and E-commerce'
}

// ============ AUCTION ============

Table auctions {
  id uuid [pk]
  seller_id uuid [not null]
  category_id uuid [not null]
  title varchar [not null]
  description varchar [not null]
  condition product_condition [not null, note: 'new — AUC-001 (item condition affects auction prices for real items/collectibles)']
  status auction_status [not null, default: 'DRAFT']
  currency char [not null, default: 'USD', note: '— the default can be changed to THB later if needed']
  starting_price decimal [not null]
  reserve_price decimal [note: 'PRIVATE — never return it from buyer-facing APIs (AUC-003)']
  min_bid_increment decimal [not null]
  current_price decimal [not null]
  bid_count integer [not null, default: 0]
  scheduled_start_at timestamp
  original_end_at timestamp
  current_end_at timestamp
  published_at timestamp [note: 'when published (AUC-004)']
  started_at timestamp [note: 'when it actually entered ACTIVE (AUC-005)']
  ended_at timestamp
  extension_count integer [not null, default: 0, note: 'BID-004 checks the cap of 5']
  winner_user_id uuid
  winning_bid_id uuid [unique, note: 'AUC-007 records both the winner and the winning bid']
  sold_price decimal
  cancellation_reason varchar [note: 'ADM-001']
  row_version integer [not null, default: 1, note: 'optimistic concurrency (§6)']
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (status, scheduled_start_at)
    (status, current_end_at)
    (category_id, status)
    (seller_id, status)
    (status, bid_count) // AUC-008 Hot Auctions
  }

  Note: 'AUC-001..008'
}

Table auction_images {
  id uuid [pk]
  auction_id uuid [not null]
  storage_key varchar [unique, not null]
  url varchar [not null]
  alt_text varchar
  position integer [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (auction_id, position) [unique]
  }
}

Table bids {
  id uuid [pk]
  auction_id uuid [not null]
  bidder_id uuid [not null]
  amount decimal [not null]
  sequence_no integer [not null]
  client_request_id uuid [unique, not null]
  placed_at timestamp [not null, default: `now()`]

  indexes {
    (auction_id, sequence_no) [unique]
    (auction_id, amount)
    (bidder_id, placed_at)
  }

  Note: 'BID-001..002 — only accepted bids are persisted'
}

Table auction_extensions {
  id uuid [pk]
  auction_id uuid [not null]
  triggered_by_bid_id uuid [unique, not null]
  extension_number integer [not null]
  previous_end_at timestamp [not null]
  new_end_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (auction_id, extension_number) [unique]
  }

  Note: 'BID-004 anti-sniping — unique per bid, so a retry after a dropped connection cannot trigger it twice'
}

Table auction_events {
  id integer [pk, increment]
  auction_id uuid [not null]
  actor_user_id uuid [note: 'nullable — events created by the system itself']
  bid_id uuid [note: 'nullable — only for bid-related events']
  event_type auction_event_type [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (auction_id, id)
    (event_type, created_at)
  }

}

// ============ E-COMMERCE ============

Table products {
  id uuid [pk]
  seller_id uuid [not null]
  category_id uuid [not null]
  title varchar [not null]
  description varchar [not null]
  price decimal [not null]
  stock_qty integer [not null]
  condition product_condition [not null]
  negotiation_floor decimal [note: 'PRIVATE, optional — PROD-006']
  quantity_discount_min_qty integer [note: 'optional — PROD-007']
  quantity_discount_percent decimal [note: 'optional — PROD-007']
  status product_status [not null, default: 'ACTIVE']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (status, category_id)
    (seller_id, status)
  }

  Note: 'PROD-001..007 · status = SUSPENDED is reserved for ADM-005 only (ADR-0002)'
}

Table product_images {
  id uuid [pk]
  product_id uuid [not null]
  storage_key varchar [unique, not null]
  url varchar [not null]
  alt_text varchar
  position integer [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (product_id, position) [unique]
  }
}

Table carts {
  id uuid [pk]
  user_id uuid [unique, not null]
  created_at timestamp [not null, default: `now()`]

  Note: 'CART-001 — one persistent cart per user'
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]

  indexes {
    (cart_id, product_id) [unique]
  }
}

Table offers {
  id uuid [pk]
  buyer_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  offer_amount decimal [not null]
  decision offer_decision [not null]
  counter_amount decimal
  expires_at timestamp [note: 'ACCEPT/COUNTER-accepted only — 15 minutes']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (buyer_id, product_id, created_at)
  }

  Note: 'AI-003 (Optional) — 5-minute cooldown, cap of 3 per (buyer, product) per 24h'
}

Table orders {
  id uuid [pk]
  checkout_session_id uuid [not null]
  seller_id uuid [not null]
  buyer_id uuid [not null]
  payment_transaction_id uuid [not null]
  subtotal decimal [not null]
  status order_status [not null, default: 'PENDING']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (checkout_session_id, seller_id) [unique]
    (buyer_id, status)
    (seller_id, status)
  }

  Note: 'CART-003 — 1 order per seller per checkout session'
}

Table order_addresses {
  id uuid [pk]
  order_id uuid [unique, not null]
  recipient_name varchar [not null]
  line1 varchar [not null]
  line2 varchar
  city varchar [not null]
  postal_code varchar [not null]
  phone varchar [not null]

  Note: 'Snapshot of the address at checkout — cannot be edited after payment succeeds'
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null]
  product_id uuid [note: 'nullable — empty when this line is a won auction item']
  auction_id uuid [unique, note: 'nullable — empty when this line is a shop product (CART-004)']
  quantity integer [not null]
  unit_price decimal [not null, note: 'regular price, the negotiated price if an offer was accepted, or sold_price for an auction item']

  Note: 'Each line is always tied to exactly one of product or auction, the same pattern as conversations. unique on auction_id means an auction can only ever be paid for once — Postgres treats NULLs as always distinct, so the constraint only applies to auction lines and does not affect product lines (CART-004)'
}

Table payment_transactions {
  id uuid [pk]
  checkout_session_id uuid [unique, not null]
  status payment_status [not null]
  method varchar [not null, note: 'Card / Bank Transfer / e-Wallet — UI only']
  created_at timestamp [not null, default: `now()`]

  Note: 'CART-004 — 1 payment per checkout_session_id, not per order'
}

Table conversations {
  id uuid [pk]
  product_id uuid [note: 'nullable — empty when this room belongs to an auction item']
  auction_id uuid [note: 'nullable — empty when this room belongs to a shop product (CHAT-004)']
  buyer_id uuid [not null]
  seller_id uuid [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (product_id, buyer_id, seller_id) [unique]
    (auction_id, buyer_id, seller_id) [unique]
  }

  Note: 'CHAT-001 (Optional) — reopening with the same pair always returns to the same thread. CHAT-004 adds the auction side — a room is always tied to exactly one of product or auction, never both, hence the separate unique sets'
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  body varchar [not null]
  created_at timestamp [not null, default: `now()`]
  read_at timestamp

  indexes {
    (conversation_id, created_at)
  }

  Note: 'CHAT-002 (Optional) — text-only messages in V1'
}

Table shipments {
  id uuid [pk]
  order_id uuid [unique, not null]
  tracking_number varchar [note: 'generated automatically on entering SHIPPED']
  carrier varchar [note: 'simulated carrier name']
  status shipment_status [not null, default: 'PROCESSING']
  created_at timestamp [not null, default: `now()`]

  Note: 'SHIP-001 — status cannot move backwards'
}

Table shipment_events {
  id integer [pk, increment, note: 'same pattern as auction_events']
  shipment_id uuid [not null]
  actor_user_id uuid [note: 'nullable — events created by the system itself']
  event_type shipment_status [not null, note: 'reuses the same type as shipments.status — every value matches, no separate enum needed']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (shipment_id, id)
  }

  Note: 'Append-only log, same pattern as auction_events — SHIP-001/002'
}

// ============ ENGAGEMENT ============

Table watchlists {
  user_id uuid [not null]
  auction_id uuid [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, auction_id) [pk]
    (auction_id, created_at)
  }

  Note: 'WAT-001/002'
}

Table product_watchlists {
  user_id uuid [not null]
  product_id uuid [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, product_id) [pk]
    (product_id, created_at)
  }

  Note: 'new — watching shop products, extending WAT-001/002. A separate table because products and auctions live in separate tables, but the shape is identical so the two lists behave the same from the outside'
}

Table auction_participants {
  user_id uuid [not null]
  auction_id uuid [not null]
  status participant_status [not null, default: 'JOINED']
  joined_at timestamp [not null, default: `now()`]
  last_seen_at timestamp

  indexes {
    (auction_id, user_id) [pk]
    (auction_id, status)
  }

  Note: 'LIV-001'
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  auction_id uuid [note: 'CHANGED — nullable because some types are not auction-related']
  bid_id uuid
  order_id uuid [note: 'new — NOT-005..007']
  conversation_id uuid [note: 'new — NOT-008 (Optional)']
  type notification_type [not null]
  title varchar [not null]
  message varchar [not null]
  read_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, read_at, created_at)
  }

  Note: 'NOT-001..008 — title/message (not a JSON payload, plain text); order_id/conversation_id added so the client knows what to refetch (§5.2)'
}

Table admin_actions {
  id uuid [pk]
  admin_user_id uuid [not null]
  target_user_id uuid
  auction_id uuid
  category_id uuid
  product_id uuid [note: 'new — ADM-005, added following the nullable-FK pattern']
  action_type admin_action_type [not null]
  note varchar
  created_at timestamp [not null, default: `now()`]

  indexes {
    (admin_user_id, created_at)
    (action_type, created_at)
  }

  Note: 'ADM-001, ADM-004, ADM-005'
}

Table ai_requests {
  id uuid [pk]
  user_id uuid [not null]
  type ai_request_type [not null]
  created_at timestamp [not null, default: `now()`]

  Note: 'new — AI-002/AI-003 (Optional), log-level only, used for rate-limiting'
}

Table support_chat_sessions {
  id uuid [pk]
  user_id uuid [not null]
  status support_session_status [not null, default: 'AI_ONLY']
  assigned_admin_id uuid [note: 'nullable — the Admin who took ownership of this conversation (AI-001)']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (status, created_at)
  }

  Note: 'new — AI-001 (required), session-scoped. After 3 consecutive AI misses, or when the user asks for staff directly, it is handed over as ESCALATED and queued for an Admin — from then on the AI is no longer called'
}

Table support_chat_messages {
  id uuid [pk]
  session_id uuid [not null]
  role chat_role [not null]
  body varchar [not null]
  created_at timestamp [not null, default: `now()`]
}

// ============ RELATIONSHIPS ============

Ref: user_profiles.user_id > users.id
Ref: auth_accounts.user_id > users.id
Ref: user_sessions.user_id > users.id
Ref: two_factor_codes.user_id > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: trusted_devices.user_id > users.id

Ref: categories.parent_id > categories.id
Ref: categories.created_by_admin_id > users.id

Ref: auctions.seller_id > users.id
Ref: auctions.winner_user_id > users.id
Ref: auctions.category_id > categories.id
Ref: auctions.winning_bid_id > bids.id
Ref: auction_images.auction_id > auctions.id
Ref: bids.auction_id > auctions.id
Ref: bids.bidder_id > users.id
Ref: auction_extensions.auction_id > auctions.id
Ref: auction_extensions.triggered_by_bid_id > bids.id
Ref: auction_events.auction_id > auctions.id
Ref: auction_events.actor_user_id > users.id
Ref: auction_events.bid_id > bids.id

Ref: products.seller_id > users.id
Ref: products.category_id > categories.id
Ref: product_images.product_id > products.id
Ref: carts.user_id > users.id
Ref: cart_items.cart_id > carts.id
Ref: cart_items.product_id > products.id
Ref: offers.buyer_id > users.id
Ref: offers.product_id > products.id
Ref: orders.seller_id > users.id
Ref: orders.buyer_id > users.id
Ref: orders.payment_transaction_id > payment_transactions.id
Ref: order_addresses.order_id > orders.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_items.auction_id > auctions.id
Ref: conversations.product_id > products.id
Ref: conversations.auction_id > auctions.id
Ref: conversations.buyer_id > users.id
Ref: conversations.seller_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: messages.sender_id > users.id
Ref: shipments.order_id > orders.id
Ref: shipment_events.shipment_id > shipments.id
Ref: shipment_events.actor_user_id > users.id

Ref: watchlists.user_id > users.id
Ref: watchlists.auction_id > auctions.id
Ref: product_watchlists.user_id > users.id
Ref: product_watchlists.product_id > products.id
Ref: auction_participants.auction_id > auctions.id
Ref: auction_participants.user_id > users.id
Ref: notifications.user_id > users.id
Ref: notifications.auction_id > auctions.id
Ref: notifications.bid_id > bids.id
Ref: notifications.order_id > orders.id
Ref: notifications.conversation_id > conversations.id
Ref: admin_actions.admin_user_id > users.id
Ref: admin_actions.target_user_id > users.id
Ref: admin_actions.auction_id > auctions.id
Ref: admin_actions.category_id > categories.id
Ref: admin_actions.product_id > products.id
Ref: ai_requests.user_id > users.id
Ref: support_chat_sessions.user_id > users.id
Ref: support_chat_sessions.assigned_admin_id > users.id
Ref: support_chat_messages.session_id > support_chat_sessions.id

// ============ TABLE GROUPS ============

TableGroup Identity {
  users
  user_profiles
  auth_accounts
  user_sessions
  two_factor_codes
  password_reset_tokens
  trusted_devices
}

TableGroup Shared {
  categories
}

TableGroup Auction {
  auctions
  auction_images
  bids
  auction_extensions
  auction_events
}

TableGroup Ecommerce {
  products
  product_images
  carts
  cart_items
  offers
  orders
  order_addresses
  order_items
  payment_transactions
  conversations
  messages
  shipments
  shipment_events
}

TableGroup Engagement {
  watchlists
  product_watchlists
  auction_participants
  notifications
  admin_actions
  ai_requests
  support_chat_sessions
  support_chat_messages
}
