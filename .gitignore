node_modules/
.env
.env.local
dist/
.next/
coverage/
output/

# AI agent tool skills/config (e.g. Prisma agent skills), not project source
.agents/
.claude/*
!.claude/skills/
.windsurf/
skills-lock.json

# Each person's own editor settings — not synced to the team
.vscode/

# There must be only one lockfile, at the root (pnpm workspace)
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# Local-only source photos for seed-mock.ts / seed-mock-auction.ts — Cloudinary
# hosts the uploaded copies, the originals never need to be in git.
# See apps/api/prisma/mock-images/README.md
apps/api/prisma/mock-images/**/*.jpg
apps/api/prisma/mock-images/**/*.jpeg
apps/api/prisma/mock-images/**/*.png
apps/api/prisma/mock-images/**/*.webp
apps/api/prisma/mock-images/**/*.gif
