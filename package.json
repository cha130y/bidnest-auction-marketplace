{
  "name": "bidnest-auction-marketplace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "check:setup": "node scripts/check-setup.mjs",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm --dir apps/api exec tsc --noEmit && pnpm --dir apps/web exec next typegen && pnpm --dir apps/web exec tsc --noEmit && pnpm test && pnpm lint"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --dir apps/web exec eslint --fix --max-warnings=0"
    ],
    "apps/api/**/*.ts": [
      "pnpm --dir apps/api exec eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
