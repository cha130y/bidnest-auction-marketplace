# Copy this file to .env and fill in your local values.

DATABASE_URL="postgresql://bidnest:dev_password@localhost:5433/bidnest_db?schema=public"

# API server port. Must differ from apps/web (default 3000) to avoid EADDRINUSE.
PORT=4000

# Where apps/web is served from — used to build the password reset link (AUTH-005)
# and as the allowed CORS origin.
WEB_APP_URL="http://localhost:3000"

# JWT signing secrets (AUTH-002 / AUTH-004). Minimum 32 characters each and they
# MUST be different from one another. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-min-32-chars"
JWT_REFRESH_TTL="7d"

# Mandatory email 2FA (AUTH-007)
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Lets an ADMIN sign in on the password alone, with no emailed code.
# On locally so the admin panel can be opened without waiting on a mailbox.
#
# Leave it off in production unless you have decided otherwise there: it makes
# an admin password the only thing guarding the admin panel, and the seeded
# admin password is in prisma/seed.ts for anyone to read. Absent reads as off.
ADMIN_SKIP_2FA=true

# Read by prisma/promote-admins.ts only — the API itself never looks at it.
# Addresses of accounts to move from USER to ADMIN, separated by commas. The
# accounts have to exist already: everyone signs up through the real flow and
# this only changes what they are allowed to do afterwards.
#
# On Railway put the value in WITHOUT the quotes. dotenv strips them here, a
# dashboard does not, and a quoted value there becomes an address with a quote
# character stuck to it, which matches nobody.
ADMIN_EMAILS=""

# Single-use password reset link (AUTH-005)
PASSWORD_RESET_TTL_MINUTES=30

# AUTH-007 — how long a browser stays trusted after answering a code once.
# The code is mandatory the first time an account signs in from a browser;
# after that the same browser is let through without one until this expires.
# Set it short to make the code more frequent, or delete a row from
# trusted_devices to forget a browser immediately. A password reset revokes
# every one of them.
TRUSTED_DEVICE_TTL_DAYS=30

# Maildev in dev (see infra/docker/compose.dev.yml). Production uses a real SMTP
# relay through the same interface — never point production at Maildev, whose
# dashboard shows every OTP to anyone who can reach it.
#
# Switching is env only, no code changes. Pick a provider and fill in the four
# values below; MAIL_USER and MAIL_PASSWORD stay empty for Maildev, which asks
# for no login and offers no TLS.
#
#   Resend     MAIL_HOST=smtp.resend.com   MAIL_PORT=587
#              MAIL_USER=resend            MAIL_PASSWORD=<API key, re_...>
#   SendGrid   MAIL_HOST=smtp.sendgrid.net MAIL_PORT=587
#              MAIL_USER=apikey            MAIL_PASSWORD=<API key, SG....>
#   Gmail      MAIL_HOST=smtp.gmail.com    MAIL_PORT=587
#              MAIL_USER=<your address>    MAIL_PASSWORD=<App Password>
#              An App Password, not the account password — it needs 2-step
#              verification switched on first. Gmail also caps sending at a few
#              hundred a day, so it suits a demo and not a launch.
#
# MAIL_FROM must be an address the provider has verified as yours, or it will
# be rejected or land in spam. Only Gmail is exempt: it rewrites the sender to
# the account's own address regardless of what is set here.
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_FROM="BidNest <no-reply@bidnest.local>"
# Left empty, the transport sends without logging in — which is what Maildev
# wants. Set both or neither: half a credential makes the relay reject the
# connection outright.
MAIL_USER=
MAIL_PASSWORD=
# Implicit TLS — leave unset and it follows the port, on for 465 and off for
# 587, which upgrades through STARTTLS instead. Set it only for a relay that
# does something unusual on a non-standard port.
MAIL_SECURE=

# Section 6 rate limits, per IP per window.
# THROTTLE_LIMIT is the blanket cap on every route; the two below tighten the
# endpoints worth brute forcing. Raise them locally if a manual test trips them.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5
OTP_THROTTLE_LIMIT=10

# AUTH-003 / AUTH-006 — public identifiers only, used to check that a token
# was issued for this app. The matching secrets belong to apps/web, not here.
# Google:  console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Line:    developers.line.biz -> LINE Login channel -> Channel ID
GOOGLE_CLIENT_ID=
LINE_CHANNEL_ID=

# AI-001/AI-002/AI-003 (Dev 5). GEMINI_API_KEY is optional: leave blank and
# the API still boots, /support/chat just answers 503. Only needed to test
# the chatbot itself. Get a free key at aistudio.google.com/apikey.
GEMINI_API_KEY=
AI_NEGOTIATOR_JWT_SECRET="dev-negotiator-secret-change-me"

# AUC-001 — image upload (Dev 4). Optional: leave blank and the API still
# boots, the upload route just answers 503. Only needed to test uploading.
# Sign up at cloudinary.com (free tier, no card) -> Dashboard -> Product
# Environment Credentials. Each developer uses their own; never commit .env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
