# Copy this file to .env and fill in your local values.

DATABASE_URL="postgresql://bidnest:dev_password@localhost:5433/bidnest_db?schema=public"

# API server port. Must differ from apps/web (default 3000) to avoid EADDRINUSE.
PORT=4000

# Where apps/web is served from — used to build the password reset link (AUTH-005).
WEB_APP_URL="http://localhost:3000"

# JWT signing secrets (AUTH-002 / AUTH-004). Minimum 32 characters each and they
# MUST be different from one another. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-min-32-chars"
JWT_REFRESH_TTL="7d"

# Mandatory email 2FA (AUTH-007)
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Single-use password reset link (AUTH-005)
PASSWORD_RESET_TTL_MINUTES=30

# Maildev in dev (see infra/docker/compose.dev.yml). Production uses a real SMTP
# relay through the same interface — never point production at Maildev.
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_FROM="BidNest <no-reply@bidnest.local>"
