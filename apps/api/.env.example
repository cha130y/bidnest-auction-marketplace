# Copy this file to .env and fill in your local values.

DATABASE_URL="postgresql://bidnest:dev_password@localhost:5433/bidnest_db?schema=public"

# API server port. Must differ from apps/web (default 3000) to avoid EADDRINUSE.
PORT=4000

# Where apps/web is served from — used to build the password reset link (AUTH-005)
# and as the allowed CORS origin.
WEB_APP_URL="http://localhost:3000"

# JWT signing secrets (AUTH-002 / AUTH-004). Minimum 32 characters each and they
# MUST be different from one another. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-min-32-chars"
JWT_REFRESH_TTL="7d"

# Mandatory email 2FA (AUTH-007)
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Single-use password reset link (AUTH-005)
PASSWORD_RESET_TTL_MINUTES=30

# Maildev in dev (see infra/docker/compose.dev.yml). Production uses a real SMTP
# relay through the same interface — never point production at Maildev.
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_FROM="BidNest <no-reply@bidnest.local>"

# Section 6 rate limits, per IP per window.
# THROTTLE_LIMIT is the blanket cap on every route; the two below tighten the
# endpoints worth brute forcing. Raise them locally if a manual test trips them.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5
OTP_THROTTLE_LIMIT=10

# AUTH-003 / AUTH-006 — public identifiers only, used to check that a token
# was issued for this app. The matching secrets belong to apps/web, not here.
# Google:  console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Line:    developers.line.biz -> LINE Login channel -> Channel ID
GOOGLE_CLIENT_ID=
LINE_CHANNEL_ID=

# AI-001/AI-002/AI-003 (Dev 5)
GEMINI_API_KEY="your-gemini-api-key"
AI_NEGOTIATOR_JWT_SECRET="dev-negotiator-secret-change-me"
