###############################################################################
# WATCHLIST — watching auctions (Dev 4)
# The whole file can be run top to bottom (request 1 passes its id to the requests after it)
#
# Covered so far: WAT-001 add/remove one item at a time
#                    WAT-002 the watched list, with status, countdown,
# current price and result
#
# 💡 "One item at a time" per the SRS criterion = there is no endpoint that accepts an array
#    so a client can never end up in an "added 5, 3 succeeded" state and have to work out
#    which ones made it
#
# 💡 Unlike "joining" (LIV-001 participants), an auction that has ended
#    can still be watched — people want to keep the result — whereas joining an ended auction
#    is meaningless because there is nothing left to take part in
###############################################################################

@baseUrl = http://localhost:4000
@sellerA = 00000000-0000-4000-8000-000000000002
@buyer   = 00000000-0000-4000-8000-000000000004
@catCollectibles = 00000000-0000-4000-8000-000000000103

# AUTH-008 — paste the tokens from `pnpm --filter api exec prisma db seed`
@adminToken   =
@sellerAToken =
@buyerToken   =

#=============================================================================
# 1. Prepare two auctions
#=============================================================================

### an auction that has not started
# @name scheduledDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Watchlist test item (not started)",
  "description": "Waiting for the start time",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-12-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Scheduled"]
}

@scheduledId = {{scheduledDraft.response.body.$.id}}

### publish. expect 200 + status SCHEDULED
POST {{baseUrl}}/auctions/drafts/{{scheduledId}}/publish
Authorization: Bearer {{sellerAToken}}

### a running auction
# @name liveDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Watchlist test item (running)",
  "description": "Already started",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-08-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Live"]
}

@liveId = {{liveDraft.response.body.$.id}}

### publish. expect 200 + status ACTIVE
POST {{baseUrl}}/auctions/drafts/{{liveId}}/publish
Authorization: Bearer {{sellerAToken}}

### an unpublished draft for testing the rejection case
# @name privateDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Unpublished draft",
  "description": "Nobody should see this yet",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 1000,
  "minBidIncrement": 50,
  "scheduledStartAt": "2026-12-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Draft"]
}

@draftId = {{privateDraft.response.body.$.id}}

#=============================================================================
# 2. Add / remove (WAT-001)
#=============================================================================

### add the auction that has not started. expect 200 + watching true + watchedAt set
# Answers 200, not 201, because sending again creates nothing new — answering 201 would be a lie
POST {{baseUrl}}/auctions/{{scheduledId}}/watchlist
Authorization: Bearer {{buyerToken}}

### sending again = idempotent. expect 200 + exactly the same watchedAt
# watchedAt doesn't move, so the item's position in the list doesn't jump on a repeat click
POST {{baseUrl}}/auctions/{{scheduledId}}/watchlist
Authorization: Bearer {{buyerToken}}

### add the running auction. expect 200
POST {{baseUrl}}/auctions/{{liveId}}/watchlist
Authorization: Bearer {{buyerToken}}

### remove. expect 200 + watching false + removed true
DELETE {{baseUrl}}/auctions/{{scheduledId}}/watchlist
Authorization: Bearer {{buyerToken}}

### removing again when no longer watching. expect 200 + removed false
# Not an error — the caller wanted it gone, and it is gone
DELETE {{baseUrl}}/auctions/{{scheduledId}}/watchlist
Authorization: Bearer {{buyerToken}}

### add it back, so the list has 2 items for the next section. expect 200
POST {{baseUrl}}/auctions/{{scheduledId}}/watchlist
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 3. The watched list (WAT-002)
#=============================================================================

### my own list. expect 200
# Check each item:
#   auction.status        — SCHEDULED / ACTIVE / SOLD / UNSOLD
#   auction.currentPrice  — the current price
#   countdown             — startsAt / endsAt / msUntilStart / msUntilEnd
#   result                — null for as long as it hasn't ended
#   watchedAt             — when it was watched
#
# Most recently watched first (scheduledId is on top because it was just added back)
# ⚠️ reservePrice (4500) must not appear at all, because the buyer is not the owner (AUC-003)
GET {{baseUrl}}/watchlist
Authorization: Bearer {{buyerToken}}

### every row on the same page uses the same serverTime for its countdown
# Send again and compare: items[0].countdown.serverTime must exactly equal items[1]
# otherwise two clocks on the same screen would tick out of step
GET {{baseUrl}}/watchlist
Authorization: Bearer {{buyerToken}}

### pagination. expect 200 + 1 item + meta.total 2
GET {{baseUrl}}/watchlist?page=2&limit=1
Authorization: Bearer {{buyerToken}}

### a seller can watch their own auction and sees their own reservePrice. expect 200
POST {{baseUrl}}/auctions/{{liveId}}/watchlist
Authorization: Bearer {{sellerAToken}}

### check they see their own reserve. expect 200 + reservePrice "4500"
# Uses the same mapper as GET /auctions/:id, so permissions match everywhere
GET {{baseUrl}}/watchlist
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 4. Cases that must be rejected
#=============================================================================

### an unpublished draft. expect 404
# Answers 404, not 403, because 403 = admitting the draft exists
POST {{baseUrl}}/auctions/{{draftId}}/watchlist
Authorization: Bearer {{buyerToken}}

### an id that doesn't exist. expect 404
POST {{baseUrl}}/auctions/00000000-0000-4000-8000-0000000009ff/watchlist
Authorization: Bearer {{buyerToken}}

### an id that is not a UUID. expect 400 from ParseUUIDPipe
POST {{baseUrl}}/auctions/not-a-uuid/watchlist
Authorization: Bearer {{buyerToken}}

### not logged in. expect 401
POST {{baseUrl}}/auctions/{{liveId}}/watchlist

### not logged in, viewing the list. expect 401
GET {{baseUrl}}/watchlist

### an admin can't watch (SRS section 2 — admins oversee the market, they don't take part). expect 403
POST {{baseUrl}}/auctions/{{liveId}}/watchlist
Authorization: Bearer {{adminToken}}

### an admin can't view the list. expect 403
GET {{baseUrl}}/watchlist
Authorization: Bearer {{adminToken}}

#=============================================================================
# 5. Results in the list once an auction ends
#=============================================================================
#
# Let {{liveId}} expire, then have read repair close it (AUC-007):
#
#   docker exec docker-postgres-1 psql -U bidnest -d bidnest_db -c \
#     "update auctions set current_end_at = now() - interval '1 second' \
#      where id = '<liveId>';"
#
# then send GET /auctions/<liveId> once to trigger it
#=============================================================================

### after the auction ends. expect 200
# Check: that row's result is no longer null
#   bids reached 4500   -> outcome SOLD, soldPrice set
#   did not reach it    -> outcome UNSOLD, soldPrice null, but finalPrice still says
#                          how far bidding got ("final price", per the criterion)
#   nobody bid at all   -> outcome UNSOLD, finalPrice null (not "0")
GET {{baseUrl}}/watchlist
Authorization: Bearer {{buyerToken}}

### a cancelled auction drops out of the list by itself
# CANCELLED is not in PUBLIC_AUCTION_STATUSES, so the row disappears instead of lingering as
# an item you can't open — try cancelling {{scheduledId}} and sending again
POST {{baseUrl}}/auctions/{{scheduledId}}/cancel
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "reason": "No longer selling" }

### check it really dropped out. expect 200 + no scheduledId in the list
GET {{baseUrl}}/watchlist
Authorization: Bearer {{buyerToken}}
