###############################################################################
# NOT — in-app notification bell (NOT-005..008)
#
# This file does "not" create notifications itself — these rows come from other flows:
#   NOT-005 Order Placed     <- successful checkout (03-order.http)
#   NOT-006 Shipment Update  <- seller advances the shipment status (04-shipment.http)
#   NOT-007 Delivered        <- moved to DELIVERED (04-shipment.http)
#   NOT-008 New Message      <- a new message in a chat room (05-chat.http)
#
# ==> Run 03/04/05 successfully first, otherwise this file gets an empty list
#
# One endpoint covers all 8 types (including the auction side, NOT-001..004) because there is
# only one bell on screen. With a separate endpoint per side, the frontend would have to call two
# places and add the unread counts itself, which goes wrong as soon as only one call succeeds
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — needs a real bearer token; run the seed, then copy and paste the @xToken lines
# (tokens expire per JWT_ACCESS_TTL — once you start getting 401, seed again)
@buyerToken   =
@sellerAToken =

#=============================================================================
# 1. Reading the list
#=============================================================================

### NOT-005..008 all of my own notifications. expect 200
# The response has 3 parts: items, unread (the bell number), meta (pagination)
# unread counts "every unread row", not just this page or those matching the filter
# @name list
GET {{baseUrl}}/notifications?limit=5
Authorization: Bearer {{buyerToken}}

@notificationId = {{list.response.body.$.items[0].id}}

### the bell number only — lighter than fetching the whole list. expect 200
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{buyerToken}}

### filter to unread only. expect 200
GET {{baseUrl}}/notifications?unreadOnly=true
Authorization: Bearer {{buyerToken}}

### filter to a single type. expect 200 — must return only ORDER_PLACED
GET {{baseUrl}}/notifications?types=ORDER_PLACED
Authorization: Bearer {{buyerToken}}

### filter to several types separated by commas (for a "Buying & selling" tab separate from "Auctions"). expect 200
GET {{baseUrl}}/notifications?types=ORDER_PLACED,SHIPMENT_UPDATE,DELIVERED,NEW_MESSAGE
Authorization: Bearer {{buyerToken}}

### pagination. expect 200
GET {{baseUrl}}/notifications?page=2&limit=5
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 2. Marking as read
#=============================================================================

### mark one as read. expect 200 — readAt must change from null to the current time
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{buyerToken}}

### mark the same one again. expect 200 — readAt must stay "the same", not a new time
# The bell should say when the user first saw it, not when they last clicked
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{buyerToken}}

### check the count went down by 1. expect 200
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{buyerToken}}

### mark all as read at once. expect 200 + { "updated": n }
PATCH {{baseUrl}}/notifications/read-all
Authorization: Bearer {{buyerToken}}

### confirm everything is cleared. expect 200 + unread 0
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 3. Cases that must be rejected
#=============================================================================

### no token. expect 401
GET {{baseUrl}}/notifications

### forged token. expect 401
GET {{baseUrl}}/notifications
Authorization: Bearer not-a-real-token

### marking someone else's as read. expect 404 (not 403)
# Answers 404 so outsiders cannot even tell whether this id exists (SRS 6)
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{sellerAToken}}

### id is not a UUID. expect 400
PATCH {{baseUrl}}/notifications/abc/read
Authorization: Bearer {{buyerToken}}

### a well-formed UUID that doesn't exist. expect 404
PATCH {{baseUrl}}/notifications/00000000-0000-4000-8000-999999999999/read
Authorization: Bearer {{buyerToken}}

### a type not in the enum. expect 400
GET {{baseUrl}}/notifications?types=NOPE
Authorization: Bearer {{buyerToken}}

### unreadOnly that is not true/false. expect 400
# Deliberately 400 rather than silently treated as false, otherwise the frontend would get the wrong list without knowing
GET {{baseUrl}}/notifications?unreadOnly=yes
Authorization: Bearer {{buyerToken}}

### limit above the cap of 100. expect 400
GET {{baseUrl}}/notifications?limit=101
Authorization: Bearer {{buyerToken}}
