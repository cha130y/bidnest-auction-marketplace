###############################################################################
# ORDER / CHECKOUT — cart -> payment (simulated) -> orders split per seller
#
# This file runs on its own: the first requests fill the cart first
# Items from 2 sellers in one cart -> a single checkout must produce 2 orders (CART-003)
# No real money moves; everything goes through MockPaymentProvider (SRS 1.2)
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@buyerToken =
@sellerAToken =

@productA2 = 00000000-0000-4000-8000-000000000202
@productB1 = 00000000-0000-4000-8000-000000000203

### setup — add seller A's item to the cart
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA2}}", "quantity": 1 }

### setup — add seller B's item to the cart (makes sellerCount = 2)
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productB1}}", "quantity": 1 }

### CART-004/005 checkout — expect 201, paymentStatus SUCCEEDED, 2 orders
# The server log must show "[simulated] charge ... -> SUCCEEDED"
# and "[stub] notification:created -> user:..."
# @name checkout
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "paymentMethod": "CARD",
  "shippingAddress": {
    "recipientName": "Anan B.",
    "line1": "123 Sukhumvit Rd",
    "line2": "Room 15A",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0812345678"
  }
}

@orderId = {{checkout.response.body.$.orders[0].id}}

### verify the cart was cleared after a successful payment — items must be empty
GET {{baseUrl}}/cart
Authorization: Bearer {{buyerToken}}

### ORD-001 my purchases (buyer view). expect 200
GET {{baseUrl}}/orders
Authorization: Bearer {{buyerToken}}

### ORD-001 filter by status + pagination
GET {{baseUrl}}/orders?status=PAID&page=1&limit=5
Authorization: Bearer {{buyerToken}}

### ORD-002 my sales (seller A view). expect 200
# The first order returned here is definitely seller A's, so its id can be used below
# without guessing whether checkout's orders[0] belongs to A or B
# @name sellingA
GET {{baseUrl}}/orders/selling
Authorization: Bearer {{sellerAToken}}

@sellerOrderId = {{sellingA.response.body.$.items[0].id}}

### ORD-003 order detail — the buyer can view it. expect 200
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{buyerToken}}

### ORD-003 order detail — the seller in that order can view it too. expect 200
GET {{baseUrl}}/orders/{{sellerOrderId}}
Authorization: Bearer {{sellerAToken}}

### PROD-005 verify stock was actually deducted after checkout
GET {{baseUrl}}/products/{{productA2}}
