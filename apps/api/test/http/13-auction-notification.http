###############################################################################
# NOTIFICATION — auction-side notifications (Dev 4)
# The whole file can be run top to bottom (request 1 passes its id to the requests after it)
#
# Covered so far: NOT-001 Outbid, NOT-002 AuctionWon,
# NOT-003 AuctionEnded, NOT-004 AuctionCancelled
#
# 💡 This file only covers the side that "causes" notifications; the reading side (GET /notifications,
#    unread-count, mark read) belongs to Dev 3, in 10-notification.http
#    Here GET /notifications is used only to "verify results"
#
# 💡 Every row is written in the same transaction as the event that causes it (SRS section 6)
#    so a successfully closed auction always has all its notifications — never "closed but nobody knows"
#
# 💡 Every notification is also pushed immediately to the owner's private WebSocket room — see section 4
###############################################################################

@baseUrl = http://localhost:4000
@sellerA = 00000000-0000-4000-8000-000000000002
@sellerB = 00000000-0000-4000-8000-000000000003
@buyer   = 00000000-0000-4000-8000-000000000004
@catCollectibles = 00000000-0000-4000-8000-000000000103

# AUTH-008 — paste the tokens from `pnpm --filter api exec prisma db seed`
@sellerAToken =
@sellerBToken =
@buyerToken   =

#=============================================================================
# 1. Outbid (NOT-001)
#=============================================================================

### create + publish a running auction
# @name liveDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Notification test item",
  "description": "Already started",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-08-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Notify"]
}

@liveId = {{liveDraft.response.body.$.id}}

### publish. expect 200 + status ACTIVE
POST {{baseUrl}}/auctions/drafts/{{liveId}}/publish
Authorization: Bearer {{sellerAToken}}

### first bid, by buyer. expect 201
# Nobody has been outbid yet — no notification is created at all
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "amount": 3000, "clientRequestId": "22222222-2222-4222-8222-222222222201" }

### check nothing reached buyer's bell. expect 200 + meta.total 0
GET {{baseUrl}}/notifications?types=OUTBID
Authorization: Bearer {{buyerToken}}

### buyer outbids themselves. expect 201
# The current leader raising their own bid = not overtaking anyone; still no notification
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "amount": 3200, "clientRequestId": "22222222-2222-4222-8222-222222222202" }

### check again. expect 200 + meta.total still 0
GET {{baseUrl}}/notifications?types=OUTBID
Authorization: Bearer {{buyerToken}}

### sellerB outbids. expect 201
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{sellerBToken}}
Content-Type: application/json

{ "amount": 3500, "clientRequestId": "22222222-2222-4222-8222-222222222203" }

### NOT-001 — buyer must now have 1 OUTBID row. expect 200
# Check: type OUTBID, auctionId = liveId, bidId = id of the overtaking bid
#       message contains the auction name and "THB 3,500.00"
GET {{baseUrl}}/notifications?types=OUTBID
Authorization: Bearer {{buyerToken}}

### sellerB must get nothing (they did the outbidding). expect 200 + meta.total 0
GET {{baseUrl}}/notifications?types=OUTBID
Authorization: Bearer {{sellerBToken}}

### the seller gets nothing either (not involved in the outbid). expect 200 + meta.total 0
GET {{baseUrl}}/notifications?types=OUTBID
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 2. AuctionWon + AuctionEnded (NOT-002 / NOT-003)
#=============================================================================
#
# Let {{liveId}} expire, then have read repair close it (AUC-007):
#
#   docker exec docker-postgres-1 psql -U bidnest -d bidnest_db -c \
#     "update auctions set current_end_at = now() - interval '1 second' \
#      where id = '<liveId>';"
#
# The latest price is 3500, below the 4500 reserve, so this auction ends UNSOLD
# For the SOLD case, bid up to 4500 before doing the steps above
#=============================================================================

### trigger the close. expect 200 + status UNSOLD (or SOLD if bids reached the reserve)
GET {{baseUrl}}/auctions/{{liveId}}

### NOT-003 — the seller must get AUCTION_ENDED. expect 200
# ⚠️ The message must not show the number 4500 — the reserve stays secret after the end (AUC-003)
#    the UNSOLD case only says "ended without meeting its reserve"
GET {{baseUrl}}/notifications?types=AUCTION_ENDED
Authorization: Bearer {{sellerAToken}}

### bidders who didn't win get AUCTION_ENDED too. expect 200
# buyer will have 2 rows: OUTBID (from step 1) + AUCTION_ENDED
GET {{baseUrl}}/notifications
Authorization: Bearer {{buyerToken}}

### in the SOLD case, the winner gets AUCTION_WON, not AUCTION_ENDED
# Deliberately just one row — two rows about the same thing would read like a system mistake
GET {{baseUrl}}/notifications?types=AUCTION_WON
Authorization: Bearer {{sellerBToken}}

#=============================================================================
# 3. AuctionCancelled (NOT-004)
#=============================================================================

### create an auction that has not started, to cancel
# @name cancelDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Item to be cancelled",
  "description": "Waiting to start",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "scheduledStartAt": "2026-12-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Cancel"]
}

@cancelId = {{cancelDraft.response.body.$.id}}

### publish. expect 200 + status SCHEDULED
POST {{baseUrl}}/auctions/drafts/{{cancelId}}/publish
Authorization: Bearer {{sellerAToken}}

### buyer watches it (WAT-001). expect 200
POST {{baseUrl}}/auctions/{{cancelId}}/watchlist
Authorization: Bearer {{buyerToken}}

### the seller watches their own too, to prove they won't be notified. expect 200
POST {{baseUrl}}/auctions/{{cancelId}}/watchlist
Authorization: Bearer {{sellerAToken}}

### the seller cancels. expect 200 + status CANCELLED
POST {{baseUrl}}/auctions/{{cancelId}}/cancel
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "reason": "Item has a defect, withdrawing it for now" }

### NOT-004 — buyer must get AUCTION_CANCELLED with the reason. expect 200
# A bare "cancelled" with no reason is exactly the kind of notification people open a support ticket about
GET {{baseUrl}}/notifications?types=AUCTION_CANCELLED
Authorization: Bearer {{buyerToken}}

### the seller must get nothing, even though they are watching. expect 200 + meta.total 0
# They cancelled it themselves — why notify them back?
GET {{baseUrl}}/notifications?types=AUCTION_CANCELLED
Authorization: Bearer {{sellerAToken}}

### Dev 3's bell works normally with auction notifications. expect 200
# unread includes auction notifications too; there is no separate bell
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 4. Delivery over WebSocket — each person's private room
#=============================================================================
#
# Besides writing a DB row, every request above also pushes to the WebSocket of that
# notification's owner immediately. .http can't test this; you need a real socket connection
#
# namespace: /user   (different from /auctions, which is for auction rooms)
# event:     notification:created  and  order:status_changed
#
# ⚠️ A token must be attached when connecting, or you are disconnected immediately — unlike /auctions, which doesn't need one
#    because auction rooms are public, whereas everything here is addressed to one person
#
#   const socket = io('http://localhost:4000/user', {
#     transports: ['websocket'],
#     auth: { token: '<access token>' }     // 'Bearer x' also works
#   });
#
#   socket.on('connection:ready',    (p) => console.log('connected', p.userId));
#   socket.on('connection:rejected', (p) => console.log('rejected', p.reason));
#   socket.on('notification:created', (n) => console.log(n.type, n.message));
#
# Cases that are disconnected (all answer connection:rejected { reason: 'Unauthorized' }
# identically, without saying what was wrong, same as the HTTP side):
#   - no token sent
#   - forged token
#   - expired token
#   - token for an account that no longer exists
#   - suspended account (ADM-002 — cut off immediately, without waiting for the token to expire)
#
# A quick way to see it for real:
#   1. keep a socket open with buyer's token
#   2. have someone else outbid buyer (section 1 above)
#   3. the socket receives notification:created immediately — exactly the same payload as in
#      GET /notifications
#
# 💡 message:sent (conversation room) is still a stub — the rule for who may join which
#    conversation room belongs to the chat module; the auction side shouldn't decide it
#=============================================================================
