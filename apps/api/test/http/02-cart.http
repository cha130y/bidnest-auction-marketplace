###############################################################################
# CART — the buyer's cart (every route requires role USER; admin can't call them)
# Every line's price is recomputed live from the seller's current price on each read (CART-002)
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@buyerToken =

@productA1 = 00000000-0000-4000-8000-000000000201
@productA2 = 00000000-0000-4000-8000-000000000202
@productB1 = 00000000-0000-4000-8000-000000000203

### CART-001 read cart — the first read creates the cart automatically. expect 200
GET {{baseUrl}}/cart
Authorization: Bearer {{buyerToken}}

### CART-001 add item — 2 keyboards (below the 3-item threshold, so no discount yet). expect 201
# @name addKeyboard
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 2 }

@keyboardItemId = {{addKeyboard.response.body.$.items[0].id}}

### CART-001 add the same item again — quantity must add up, not create a new line. expect 201
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 1 }

### PROD-007 check the discount — now 3 items, discountPercent must be 10.00
GET {{baseUrl}}/cart
Authorization: Bearer {{buyerToken}}

### CART-003 add a second seller's item — sellerCount must become 2. expect 201
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productB1}}", "quantity": 1 }

### CART-002 change the quantity of an existing line. expect 200
PATCH {{baseUrl}}/cart/items/{{keyboardItemId}}
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "quantity": 4 }

### CART-002 remove a line from the cart. expect 200
DELETE {{baseUrl}}/cart/items/{{keyboardItemId}}
Authorization: Bearer {{buyerToken}}

### Cart summary before checkout (file 03)
GET {{baseUrl}}/cart
Authorization: Bearer {{buyerToken}}
