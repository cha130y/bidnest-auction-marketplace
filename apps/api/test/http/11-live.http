###############################################################################
# LIVE — Lobby, Arena, Sudden death and results (Dev 4)
# The whole file can be run top to bottom (request 1 passes its id to the requests after it)
#
# Covered so far: LIV-001 Lobby — auction info, realtime participant count,
# countdown, participation status and automatic switch to started
#                    LIV-002 Arena — current price, masked leader, recent bids,
# time remaining, minimum next bid, reserve-met and bid button state
#                    LIV-003 Sudden death — extension count, new end time
# and urgent state
#                    LIV-004 Results — Sold/Unsold, final price and masked
# winner
#
# 💡 The countdown is sent in two forms side by side, redundant on purpose:
#    - startsAt / endsAt = wall-clock times, usable if the client's clock is right
#    - msUntilStart / msUntilEnd = ms remaining, measured from serverTime
#    Devices with a skewed clock should use the second, so the countdown is not wrong
#
# 💡 Joining (participants) is not bidding — a seller can enter their own auction room
#    (but can't bid, per BID-001), while an admin can't join at all (SRS section 2)
###############################################################################

@baseUrl = http://localhost:4000
@sellerA = 00000000-0000-4000-8000-000000000002
@buyer   = 00000000-0000-4000-8000-000000000004
@catCollectibles = 00000000-0000-4000-8000-000000000103

# AUTH-008 — paste the tokens from `pnpm --filter api exec prisma db seed`
@adminToken   =
@sellerAToken =
@buyerToken   =

#=============================================================================
# 1. Prepare an auction that has not started (SCHEDULED) — the status the lobby exists for
#=============================================================================

### create a draft that starts in the future
# @name lobbyDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Lobby test item",
  "description": "Not started yet, counting down",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-12-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Lobby"]
}

@lobbyId = {{lobbyDraft.response.body.$.id}}

### draft not published yet — no lobby yet. expect 404
# Answers 404, not 403, because 403 = admitting the draft exists
GET {{baseUrl}}/auctions/{{lobbyId}}/lobby
Authorization: Bearer {{sellerAToken}}

### publish it as SCHEDULED. expect 200 + status SCHEDULED
POST {{baseUrl}}/auctions/drafts/{{lobbyId}}/publish
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 2. Reading the lobby (LIV-001)
#=============================================================================

### LIV-001 — logged-out visitors can view it too. expect 200
# Check: auction.status = SCHEDULED, participantCount = 0, you = null,
#       countdown.msUntilStart > 0, countdown.serverTime is set
# ⚠️ reservePrice (4500) must not appear anywhere in the response (AUC-003)
GET {{baseUrl}}/auctions/{{lobbyId}}/lobby

### LIV-001 — logged in but not joined yet. expect 200 + you.joined = false
GET {{baseUrl}}/auctions/{{lobbyId}}/lobby
Authorization: Bearer {{buyerToken}}

### the seller who owns the auction can see their own reservePrice. expect 200
# The lobby reads the auction through the same path as GET /auctions/:id, so permissions always match
GET {{baseUrl}}/auctions/{{lobbyId}}/lobby
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 3. Join / leave (LIV-001 — participation status)
#=============================================================================

### LIV-001 — a buyer joins. expect 200 + joined true + participantCount 1
# After commit, `auction:presence` is broadcast to this auction's room
POST {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{buyerToken}}

### sending again = idempotent. expect 200 + participantCount still 1
# No broadcast this time, because the count didn't change (a client reconnecting and calling again)
POST {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{buyerToken}}

### a seller can join their own auction. expect 200 + participantCount 2
POST {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{sellerAToken}}

### check the lobby count matches. expect 200 + participantCount 2 + you.joined true
GET {{baseUrl}}/auctions/{{lobbyId}}/lobby
Authorization: Bearer {{buyerToken}}

### leave the room. expect 200 + joined false + participantCount 1
DELETE {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{buyerToken}}

### leaving again while not in the room. expect 200 + participantCount 1 (no broadcast)
DELETE {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{buyerToken}}

### join again — joinedAt is still the time of the first join. expect 200
POST {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 4. Cases that must be rejected
#=============================================================================

### not logged in. expect 401
POST {{baseUrl}}/auctions/{{lobbyId}}/participants

### an admin can't join (SRS section 2 — admins oversee the market, they don't take part). expect 403
POST {{baseUrl}}/auctions/{{lobbyId}}/participants
Authorization: Bearer {{adminToken}}

### an id that doesn't exist. expect 404
GET {{baseUrl}}/auctions/00000000-0000-4000-8000-0000000009ff/lobby

### an id that is not a UUID. expect 400 from ParseUUIDPipe
GET {{baseUrl}}/auctions/not-a-uuid/lobby

#=============================================================================
# 5. A running auction (used again in section 6) and the ended-auction case
#=============================================================================

### create + publish an auction that has already started
# @name liveDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Arena test item",
  "description": "Already started",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "scheduledStartAt": "2026-08-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Live"]
}

@liveId = {{liveDraft.response.body.$.id}}

### publish. expect 200 + status ACTIVE
POST {{baseUrl}}/auctions/drafts/{{liveId}}/publish
Authorization: Bearer {{sellerAToken}}

### a running auction can still be joined. expect 200
# The lobby isn't only for before the start — people joining midway must be counted too
POST {{baseUrl}}/auctions/{{liveId}}/participants
Authorization: Bearer {{buyerToken}}

### lobby of a running auction. expect 200 + msUntilStart = 0 + msUntilEnd > 0
# Time already passed is reported as 0, not a negative number
GET {{baseUrl}}/auctions/{{liveId}}/lobby
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 6. Arena during the auction (LIV-002)
#=============================================================================
#
# arena = everything the lobby has + three things that only mean something once bidding is open:
# the leader, recent bids and the minimum next bid
#
# A separate endpoint from the lobby because the arena costs 2 extra queries, while the lobby exists
# for people waiting on an auction with no bids to show, who shouldn't have to pay that cost
#=============================================================================

### LIV-002 — arena before anyone bids. expect 200
# Check: leader = null, recentBids = [], auction.minimumNextBid = "3000"
#       (the starting price, not 0 + increment — currentPrice 0 means "no price yet")
GET {{baseUrl}}/auctions/{{liveId}}/arena

### first bid at exactly the starting price. expect 201
# ⚠️ When sending again, change clientRequestId, otherwise you get the same bid back (BID-002)
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "amount": 3000, "clientRequestId": "11111111-1111-4111-8111-111111111101" }

### LIV-002 — arena after a bid. expect 200
# Check: leader.bidder is a masked name (e.g. "S***i"), never a bidderId
#       leader.isYours = true (because the bidder's token was used)
#       minimumNextBid = "3100" (currentPrice + increment)
#       recentBids newest first — the opposite of BID-005's GET /bids
#       you.canBid = true, you.blockedBy = null
GET {{baseUrl}}/auctions/{{liveId}}/arena
Authorization: Bearer {{buyerToken}}

### logged out. expect 200 + you = null + leader.isYours = false
# Can still see the whole auction, there is just nothing "yours" to report
GET {{baseUrl}}/auctions/{{liveId}}/arena

### the seller views their own arena. expect 200 + blockedBy = "YOU_ARE_THE_SELLER"
# canBid is only an advance report, not a gate — BID-001 still re-checks inside the transaction
GET {{baseUrl}}/auctions/{{liveId}}/arena
Authorization: Bearer {{sellerAToken}}

### confirm the report matches reality. expect 403
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "amount": 5000, "clientRequestId": "11111111-1111-4111-8111-111111111102" }

### an admin views the arena. expect 200 + blockedBy = "ADMINS_DO_NOT_BID"
GET {{baseUrl}}/auctions/{{liveId}}/arena
Authorization: Bearer {{adminToken}}

### arena of an auction that has not started. expect 200 + blockedBy = "AUCTION_NOT_OPEN"
# The room state always comes before personal reasons — the same answer for everyone in the room
GET {{baseUrl}}/auctions/{{lobbyId}}/arena
Authorization: Bearer {{buyerToken}}

### an ended auction (SOLD/UNSOLD) can't be joined. expect 409
# You need to fill in the id of an ended auction yourself — from GET /auctions and wait for it to expire,
# or set currentEndAt in the DB to the past, then GET /auctions/:id once
# (AUC-007 read repair will close the auction), then send this request
# POST {{baseUrl}}/auctions/<ENDED-AUCTION-ID>/participants
# Authorization: Bearer {{buyerToken}}

#=============================================================================
# 7. Sudden death — urgent state (LIV-003)
#=============================================================================
#
# `suddenDeath` comes with the arena, no extra call needed ("easy to see", as the criterion puts it)
#
# {
#   "active": false,            // in the last 2 minutes yet?
#   "windowMs": 120000,         // the window where a bid extends the time — sent, not hardcoded
#   "extensionMs": 120000,      // how many ms a bid extends by
#   "extensionCount": 0,        // how many extensions so far
#   "extensionsRemaining": 5,   // how many extensions are left
#   "lastExtension": null       // the latest one: previousEndAt -> newEndAt
# }
#
# ⚠️ `active` is still true when extensionsRemaining = 0 — on purpose, because the last 2
#    minutes of an auction that can no longer be extended are the most urgent, not the least
#=============================================================================

### a normal auction with plenty of time left. expect active = false
GET {{baseUrl}}/auctions/{{liveId}}/arena

### push it to 1 minute left, then look again
# REST has no endpoint to move the end time (correctly — a seller can't edit an ACTIVE auction
# per AUC-006), so edit the DB directly:
#
#   docker exec docker-postgres-1 psql -U bidnest -d bidnest_db -c \
#     "update auctions set current_end_at = now() + interval '1 minute' \
#      where id = '<liveId>';"
#
# then send this request. expect active = true
GET {{baseUrl}}/auctions/{{liveId}}/arena

### a bid in the last 2 minutes = time extension (BID-004). expect 201
POST {{baseUrl}}/auctions/{{liveId}}/bids
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "amount": 4000, "clientRequestId": "11111111-1111-4111-8111-111111111103" }

### look at the arena again. expect extensionCount 1, extensionsRemaining 4
# Check: lastExtension.newEndAt must exactly match countdown.endsAt
#       (if they differ = the arena is contradicting itself)
#       and active is back to false, because it was just pushed out 2 minutes
GET {{baseUrl}}/auctions/{{liveId}}/arena
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 8. Results when the auction ends (LIV-004)
#=============================================================================
#
# `result` comes with the arena like suddenDeath — null for as long as it hasn't ended
# which tells the screen it should still show the arena, not the results page
#
# {
#   "outcome": "SOLD",          // or "UNSOLD"
#   "endedAt": "…",
#   "soldPrice": "5000",        // null if not sold — because there was no sale
#   "finalPrice": "5000",       // the price bidding reached; null if nobody bid at all
#   "bidCount": 1,
#   "reserveMet": true,
#   "winner": { "amount": "5000", "bidder": "S***i", "isYours": false }
# }
#
# ⚠️ UNSOLD always has winner = null, even when someone holds the highest bid — they did not win
#    and showing their name would be lying on screen
#=============================================================================

### not ended yet. expect result = null
GET {{baseUrl}}/auctions/{{liveId}}/arena

### let it expire, then have read repair close the auction (AUC-007)
#
#   docker exec docker-postgres-1 psql -U bidnest -d bidnest_db -c \
#     "update auctions set current_end_at = now() - interval '1 second' \
#      where id = '<liveId>';"
#
# then send GET /auctions/:id once to trigger the close
GET {{baseUrl}}/auctions/{{liveId}}

### view the result. expect 200
# {{liveId}} has no reservePrice set (see section 5), so reserveMet is always true
# Check: auction.status = SOLD, auction.soldPrice is set
#       result.outcome = SOLD, result.winner.bidder is a masked name
#       result.endedAt is set
GET {{baseUrl}}/auctions/{{liveId}}/arena
Authorization: Bearer {{buyerToken}}

### others see the winner masked as well. expect isYours = false
GET {{baseUrl}}/auctions/{{liveId}}/arena

### an ended auction can't be joined. expect 409
# (this is the case left open in section 5 — now there is a real id to use)
POST {{baseUrl}}/auctions/{{liveId}}/participants
Authorization: Bearer {{buyerToken}}

### the UNSOLD case needs an auction with a reservePrice
# {{lobbyId}} has a reserve of 4500; bid only 3000 and let it end to get UNSOLD
# Check: result.outcome = UNSOLD, soldPrice = null, winner = null
#       but finalPrice = "3000" — the "final price" must still say how far bidding got
#       and 4500 must not appear anywhere (AUC-003 still applies after the end)
#
# ⚠️ Broadcast: the room gets `auction:ended` when the auction is closed successfully,
#    from either read repair or the scheduler — always announced exactly once
#    Keep a WebSocket open and follow the steps above to see this event

#=============================================================================
# 9. Automatic switch to started (LIV-001)
#=============================================================================
#
# AuctionLifecycleService runs every 10 seconds: a SCHEDULED auction whose time has come becomes
# ACTIVE on its own, then `auction:started` is broadcast to the room — so the lobby screen
# flips to the arena by itself without polling
#
# To see it for real:
#   1. create a draft with scheduledStartAt ~20 seconds ahead, then publish it
#   2. keep a WebSocket open (namespace /auctions) and emit
#      `auction:join` { "auctionId": "<id>" }
#   3. wait — an `auction:started` event arrives on its own, with endsAt
#   4. GET the lobby again and you will see status = ACTIVE and msUntilStart = 0
#
# ⚠️ ScheduleModule is disabled when NODE_ENV=test (see app.module.ts), because a pass
#    running in the background would race the very transition the test is checking
#=============================================================================
