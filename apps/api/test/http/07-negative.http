###############################################################################
# NEGATIVE — cases that are designed to "fail"
#
# How to read results: you must get the status written next to each request, and never 500
# A 500 anywhere = a real bug; report it in the PR
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@adminToken =
@buyerToken =
@sellerAToken =
@sellerBToken =

@catElectronics = 00000000-0000-4000-8000-000000000101
@productA1 = 00000000-0000-4000-8000-000000000201
@productB2 = 00000000-0000-4000-8000-000000000204

#=============================================================================
# 1. Authentication (AccessTokenGuard — AUTH-008)
#=============================================================================

### no Authorization sent to a non-public route. expect 401
GET {{baseUrl}}/cart

### a token that is not a JWT at all. expect 401
GET {{baseUrl}}/cart
Authorization: Bearer not-a-real-token

### a JWT signed with a different secret. expect 401
# the guard answers 401 for both expired and forged tokens — it doesn't say which
GET {{baseUrl}}/cart
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIwMDAwMDAwMC0wMDAwLTQwMDAtODAwMC0wMDAwMDAwMDAwMDQifQ.this-signature-is-not-valid

### a @Public route works without a token. expect 200
GET {{baseUrl}}/products

#=============================================================================
# 2. Role permissions (RolesGuard)
#=============================================================================

### an admin can't buy — the cart belongs to role USER only. expect 403
GET {{baseUrl}}/cart
Authorization: Bearer {{adminToken}}

### an admin can't check out. expect 403
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "paymentMethod": "CARD",
  "shippingAddress": {
    "recipientName": "Admin",
    "line1": "1 Admin Rd",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0800000000"
  }
}

### an admin can't list products. expect 403
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Admin should not sell",
  "description": "nope",
  "categoryId": "{{catElectronics}}",
  "price": 100,
  "stockQty": 1,
  "condition": "NEW",
  "imageUrls": ["https://placehold.co/600x400"]
}

### a regular user can't call admin endpoints. expect 403
GET {{baseUrl}}/admin/orders
Authorization: Bearer {{buyerToken}}

### a regular user can't suspend someone else's listing. expect 403
PATCH {{baseUrl}}/admin/products/{{productA1}}/deactivate
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "reason": "No permission" }

#=============================================================================
# 3. Ownership
#=============================================================================

### can't edit a product that isn't yours. expect 403
PATCH {{baseUrl}}/products/{{productA1}}
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "price": 1 }

### can't delete a product that isn't yours (seller B deletes seller A's). expect 403
DELETE {{baseUrl}}/products/{{productA1}}
Authorization: Bearer {{sellerBToken}}

### CART-001 a seller can't buy their own product. expect 403
POST {{baseUrl}}/cart/items
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 1 }

### CHAT-001 a seller can't open a chat on their own listing. expect 403
POST {{baseUrl}}/products/{{productA1}}/conversations
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 4. Invalid input (ValidationPipe: whitelist + forbidNonWhitelisted)
#=============================================================================

### sending an unknown field that is not in the DTO. expect 400
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 1, "hackerField": "boom" }

### quantity must be an integer >= 1. expect 400
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 0 }

### :id is not a UUID (ParseUUIDPipe). expect 400
GET {{baseUrl}}/products/not-a-uuid

### PROD-001 listing without a single image. expect 400
POST {{baseUrl}}/products
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "No image",
  "description": "should fail",
  "categoryId": "{{catElectronics}}",
  "price": 100,
  "stockQty": 1,
  "condition": "NEW",
  "imageUrls": []
}

### PROD-007 discount only half set (minQty but no percent). expect 400
POST {{baseUrl}}/products
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Half discount rule",
  "description": "should fail",
  "categoryId": "{{catElectronics}}",
  "price": 100,
  "stockQty": 1,
  "condition": "NEW",
  "imageUrls": ["https://placehold.co/600x400"],
  "quantityDiscountMinQty": 3
}

### PROD-002 minPrice greater than maxPrice. expect 400
GET {{baseUrl}}/products?minPrice=5000&maxPrice=100

#=============================================================================
# 5. Stock and payment
#=============================================================================

### CART-001 adding more than is in stock (figurine has 1 left). expect 400
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productB2}}", "quantity": 99 }

### CART-004 checkout with an empty cart. expect 400 "Cart is empty"
# Note: only gives this result when the buyer's cart is actually empty
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "paymentMethod": "CARD",
  "shippingAddress": {
    "recipientName": "Anan B.",
    "line1": "123 Sukhumvit Rd",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0812345678"
  }
}

#-----------------------------------------------------------------------------
# Payment-failure case — the total must be exactly 666.00
# (MockPaymentProvider.DECLINE_AMOUNT)
#
# seller A is the purchaser, so the buyer's cart doesn't mix with other tests
# run the 3 requests below in order, and seller A's cart must be empty first
#-----------------------------------------------------------------------------

### check first — seller A's cart must be empty (if not, remove its items first)
GET {{baseUrl}}/cart
Authorization: Bearer {{sellerAToken}}

### setup — seller B lists an item at 666.00. expect 201
# @name declineProduct
POST {{baseUrl}}/products
Authorization: Bearer {{sellerBToken}}
Content-Type: application/json

{
  "title": "Decline Trigger 666",
  "description": "A total of exactly 666.00 is always declined at payment",
  "categoryId": "{{catElectronics}}",
  "price": 666,
  "stockQty": 5,
  "condition": "NEW",
  "imageUrls": ["https://placehold.co/600x400?text=666"]
}

@declineProductId = {{declineProduct.response.body.$.id}}

### setup — seller A adds 1 item to the cart (total = 666.00). expect 201
POST {{baseUrl}}/cart/items
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "productId": "{{declineProductId}}", "quantity": 1 }

### CART-004 payment declined. expect 400 { message: "Payment failed", code: "PAYMENT_DECLINED", checkoutSessionId, reason }
# Side effects that must hold: no order is created + everything is still in the cart
# but there is still a FAILED row in payment_transactions for reconciliation
#
# `code` is what the web app uses to pick the screen — this is the only path where "Try again" can succeed
# Out of stock gives code: "ITEMS_UNAVAILABLE" with issues[], and losing the race after the charge gives
# code: "STOCK_LOST_AFTER_CHARGE", the only path that leaves a charge with no order
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "paymentMethod": "CARD",
  "shippingAddress": {
    "recipientName": "Somchai",
    "line1": "9 Ratchada Rd",
    "city": "Bangkok",
    "postalCode": "10400",
    "phone": "0899999999"
  }
}

### verify — the items must still be in the cart as before
GET {{baseUrl}}/cart
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 6. Shipping — needs a real order first
#=============================================================================

### setup — buyer purchases seller A's item
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 1 }

### setup — checkout
# @name checkout
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "paymentMethod": "CARD",
  "shippingAddress": {
    "recipientName": "Anan B.",
    "line1": "123 Sukhumvit Rd",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0812345678"
  }
}

@orderId = {{checkout.response.body.$.orders[0].id}}

### SHIP-001 can't skip straight from PROCESSING -> DELIVERED. expect 400
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "DELIVERED" }

### SHIP-001 the buyer can't advance the status. expect 403
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "status": "SHIPPED" }

### SHIP-001 a status not in the enum. expect 400
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "TELEPORTED" }

#=============================================================================
# 7. Data privacy — outsiders must get 404, not 403
#    (so they cannot even tell that the order/chat room exists — SRS 6)
#=============================================================================

### an outsider views someone else's order. expect 404
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{sellerBToken}}

### an outsider views someone else's shipment timeline. expect 404
GET {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerBToken}}

### setup — buyer opens a chat with seller A
# @name conversation
POST {{baseUrl}}/products/{{productA1}}/conversations
Authorization: Bearer {{buyerToken}}

@conversationId = {{conversation.response.body.$.id}}

### an outsider reads someone else's chat. expect 404
GET {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{sellerBToken}}

### an admin can't read chats either (blocked by RolesGuard first). expect 403
GET {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{adminToken}}

### CHAT-002 sending an empty message. expect 400
POST {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "body": "   " }
