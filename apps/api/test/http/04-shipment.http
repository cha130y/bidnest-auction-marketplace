###############################################################################
# SHIP — shipment timeline (100% simulated, always isSimulated: true)
#
# Status only moves forward: PROCESSING -> SHIPPED -> IN_TRANSIT -> DELIVERED
# Cancellation is only allowed while still PROCESSING
# Only the order's "seller" can advance the status / the buyer can only view
#
# This file sets up its own fresh order from scratch, so it doesn't collide with old orders
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@buyerToken =
@sellerAToken =

@productA1 = 00000000-0000-4000-8000-000000000201

### setup 1/2 — add seller A's item to the cart (one seller = one order)
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 1 }

### setup 2/2 — checkout
# @name checkout
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "paymentMethod": "BANK_TRANSFER",
  "shippingAddress": {
    "recipientName": "Anan B.",
    "line1": "123 Sukhumvit Rd",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0812345678"
  }
}

@orderId = {{checkout.response.body.$.orders[0].id}}

### SHIP-002 initial timeline — status PROCESSING, nextStatuses [SHIPPED, CANCELLED]. expect 200
GET {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{buyerToken}}

### SHIP-001 step 1 — PROCESSING -> SHIPPED, must return a trackingNumber. expect 200
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "SHIPPED" }

### SHIP-001 step 2 — SHIPPED -> IN_TRANSIT (the same trackingNumber must still be there). expect 200
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "IN_TRANSIT" }

### SHIP-001 step 3 — IN_TRANSIT -> DELIVERED. expect 200
# NOT-006 + NOT-007 -> notificationsCreated must be 2 at this step
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "DELIVERED" }

### SHIP-002 final timeline — timeline must have all 4 events, nextStatuses empty. expect 200
GET {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{buyerToken}}

### SHIP-001 can't move on from DELIVERED (final status). expect 400
PATCH {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "IN_TRANSIT" }

###############################################################################
# Cancellation case — needs another new order, because the one above has been delivered
###############################################################################

### setup — new cart
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{productA1}}", "quantity": 2 }

### setup — checkout the order to cancel
# @name cancelCheckout
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "paymentMethod": "E_WALLET",
  "shippingAddress": {
    "recipientName": "Anan B.",
    "line1": "123 Sukhumvit Rd",
    "city": "Bangkok",
    "postalCode": "10110",
    "phone": "0812345678"
  }
}

@cancelOrderId = {{cancelCheckout.response.body.$.orders[0].id}}

### SHIP-001 cancel while still PROCESSING — items must go back into stock. expect 200
PATCH {{baseUrl}}/orders/{{cancelOrderId}}/shipment
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "CANCELLED" }

### verify — order.status must be CANCELLED
GET {{baseUrl}}/orders/{{cancelOrderId}}
Authorization: Bearer {{buyerToken}}

### verify — the product's stockQty must be added back
GET {{baseUrl}}/products/{{productA1}}
