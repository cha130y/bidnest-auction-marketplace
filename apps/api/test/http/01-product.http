###############################################################################
# PROD — product listing, search, detail, edit, stock, delete
# The whole file can be run top to bottom (request 1 passes its id to the requests after it)
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@sellerAToken =

@catElectronics = 00000000-0000-4000-8000-000000000101
@productA1 = 00000000-0000-4000-8000-000000000201

### PROD-001 create — seller A lists a new product. expect 201
# negotiationFloor (2500) is below the price after the 15% discount (2720.43)
# -> the response must include warnings[] (PROD-007)
# @name createProduct
POST {{baseUrl}}/products
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Test Headphone ANC",
  "description": "Created from 01-product.http",
  "categoryId": "{{catElectronics}}",
  "price": 3200.5,
  "stockQty": 7,
  "condition": "NEW",
  "imageUrls": [
    "https://placehold.co/600x400?text=Headphone",
    "https://placehold.co/600x400?text=Headphone+2"
  ],
  "negotiationFloor": 2500,
  "quantityDiscountMinQty": 3,
  "quantityDiscountPercent": 15
}

@newProductId = {{createProduct.response.body.$.id}}

### PROD-002 search — all listings (public, no header needed). expect 200 + items/meta
GET {{baseUrl}}/products

### PROD-002 search — keyword
GET {{baseUrl}}/products?q=keyboard

### PROD-002 search — category filter + price range + price ascending + pagination
GET {{baseUrl}}/products?categoryIds={{catElectronics}}&minPrice=1000&maxPrice=5000&sort=price_asc&page=1&limit=2

### PROD-002 search — multiple categories separated by commas
GET {{baseUrl}}/products?categoryIds=00000000-0000-4000-8000-000000000101,00000000-0000-4000-8000-000000000102

### PROD-002 search — newest first
GET {{baseUrl}}/products?sort=newest

### PROD-004 detail — public view: must NOT include negotiationFloor. expect 200
GET {{baseUrl}}/products/{{productA1}}

### PROD-006 detail — owner view (seller A): must see negotiationFloor. expect 200
GET {{baseUrl}}/products/{{productA1}}
Authorization: Bearer {{sellerAToken}}

### PROD-004 detail — the product just created
GET {{baseUrl}}/products/{{newProductId}}
Authorization: Bearer {{sellerAToken}}

### PROD-003 update — change price/description. expect 200
PATCH {{baseUrl}}/products/{{newProductId}}
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "price": 2999,
  "description": "Price reduced - edited from .http"
}

### PROD-005 stock — set a new stock quantity. expect 200
PATCH {{baseUrl}}/products/{{newProductId}}/stock
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "stockQty": 3 }

### PROD-005 stock — set to 0; status should become OUT_OF_STOCK. expect 200
PATCH {{baseUrl}}/products/{{newProductId}}/stock
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "stockQty": 0 }

### PROD-005 stock — restock; status should return to ACTIVE. expect 200
PATCH {{baseUrl}}/products/{{newProductId}}/stock
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "stockQty": 7 }

### PROD-002 status — seller pauses the listing (status -> INACTIVE). expect 200
PATCH {{baseUrl}}/products/{{newProductId}}/status
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "INACTIVE" }

### verify — the public can't find it anymore
GET {{baseUrl}}/products?q=Headphone

### verify — but the owner can still open it. expect 200
GET {{baseUrl}}/products/{{newProductId}}
Authorization: Bearer {{sellerAToken}}

### PROD-002 status — seller reopens it (stock > 0, so it goes back to ACTIVE). expect 200
PATCH {{baseUrl}}/products/{{newProductId}}/status
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "ACTIVE" }

### PROD-002 status — values other than ACTIVE/INACTIVE must be rejected. expect 400
PATCH {{baseUrl}}/products/{{newProductId}}/status
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "status": "SUSPENDED" }

### PROD-003 delete — soft delete (status -> REMOVED). expect 200
DELETE {{baseUrl}}/products/{{newProductId}}
Authorization: Bearer {{sellerAToken}}

### re-check — a deleted product must not appear in search results
GET {{baseUrl}}/products?q=Headphone
