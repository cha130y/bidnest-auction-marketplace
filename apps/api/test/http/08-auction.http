###############################################################################
# AUC — วงจรชีวิตประมูล (ฝั่ง Dev 4)
# ยิงจากบนลงล่างได้ทั้งไฟล์ (request ที่ 1 ส่ง id ต่อให้ request ถัดๆ ไป)
#
# ครอบคลุมถึงตอนนี้: AUC-001 สร้าง draft ส่วนตัว, AUC-002 ตรวจสอบก่อนเผยแพร่,
# AUC-003 reserve ซ่อน, AUC-004 preview + publish, AUC-005 ผู้ซื้อมองเห็น, AUC-006 แก้ไข/ยกเลิก, AUC-007 จบประมูล, AUC-008 Hot Auctions
###############################################################################

@baseUrl = http://localhost:4000
@admin   = 00000000-0000-4000-8000-000000000001
@sellerA = 00000000-0000-4000-8000-000000000002
@buyer   = 00000000-0000-4000-8000-000000000004
@catCollectibles = 00000000-0000-4000-8000-000000000103

# AUTH-008 — MockAuthGuard ถูกถอดออกแล้ว ทุก request ต้องมี bearer token จริง
# รัน `pnpm --filter api exec prisma db seed` แล้ว copy บรรทัด @xToken ที่มันพิมพ์
# ออกมาวางตรงนี้ (token หมดอายุตาม JWT_ACCESS_TTL — พอเริ่มได้ 401 ให้ seed ใหม่)
@adminToken   =
@sellerAToken =
@buyerToken   =

#=============================================================================
# 1. สร้าง draft (AUC-001)
#=============================================================================

### AUC-001 create — draft ที่กรอกครบทุกช่อง. expect 201 + status DRAFT
# reservePrice ต้องกลับมาด้วย เพราะคนยิงคือ "เจ้าของ draft" (AUC-003)
# originalEndAt กับ currentEndAt ต้องเท่ากันทั้งคู่ = scheduledEndAt ที่ส่งไป
# @name createDraft
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Vintage Seiko 5 Automatic",
  "description": "Created from 08-auction.http — ล้างเครื่องปีที่แล้ว สายเดิมโรงงาน",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-09-01T10:00:00.000Z",
  "scheduledEndAt": "2026-09-01T12:00:00.000Z",
  "imageUrls": [
    "https://placehold.co/600x400?text=Seiko+Front",
    "https://placehold.co/600x400?text=Seiko+Back"
  ]
}

@draftId = {{createDraft.response.body.$.id}}

### AUC-001 create — draft ที่ยังกรอกไม่ครบ (ไม่มี reserve/กำหนดการ/รูป). expect 201
# ตั้งใจให้ผ่าน: SRS แยกการตรวจครบถ้วนไว้ที่ AUC-002 ตอน "ก่อนเผยแพร่"
# ไม่ใช่ตอนเซฟ draft — response ต้องได้ reservePrice: null, images: []
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Draft ที่ยังทำไม่เสร็จ",
  "description": "ยังไม่ใส่รูปกับกำหนดการ",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 500,
  "minBidIncrement": 50
}

#=============================================================================
# 2. draft เป็นของส่วนตัว (AUC-001)
#=============================================================================

### AUC-001 detail — เจ้าของเปิด draft ตัวเอง. expect 200 + เห็น reservePrice
GET {{baseUrl}}/auctions/drafts/{{draftId}}
Authorization: Bearer {{sellerAToken}}

### AUC-001 detail — user คนอื่นเปิด draft เดียวกัน. expect 404
# ต้องเป็น 404 ไม่ใช่ 403 — คำตอบต้องไม่ยืนยันว่า draft นี้มีอยู่จริง
GET {{baseUrl}}/auctions/drafts/{{draftId}}
Authorization: Bearer {{buyerToken}}

### AUC-001 detail — คนไม่ได้ login. expect 401
GET {{baseUrl}}/auctions/drafts/{{draftId}}

### AUC-001 list — เจ้าของเห็น draft ของตัวเองทั้งหมด. expect 200 + items ≥ 2
GET {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}

### AUC-001 list — คนอื่นเห็นเป็น list ว่าง. expect 200 + items: []
GET {{baseUrl}}/auctions/drafts
Authorization: Bearer {{buyerToken}}

#=============================================================================
# 3. เคสที่ต้องพัง (ห้ามมี 500)
#=============================================================================

### สิทธิ์ — แอดมินสร้างประมูลไม่ได้ (SRS §2 แอดมินกำกับดูแล ไม่ได้ขายเอง). expect 403
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Admin ไม่ควรสร้างได้",
  "description": "ต้องโดน RolesGuard ปัดตก",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10
}

### สิทธิ์ — ไม่ส่ง Authorization header. expect 401
POST {{baseUrl}}/auctions/drafts
Content-Type: application/json

{
  "title": "ไม่ได้ login",
  "description": "ต้องโดน AccessTokenGuard ปัดตก",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10
}

### หมวดหมู่ — id ที่ไม่มีอยู่จริง. expect 400
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "หมวดหมู่ไม่มีจริง",
  "description": "ต้องได้ Category not found",
  "categoryId": "00000000-0000-4000-8000-000000009999",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10
}

### หมวดหมู่ — หมวดที่ถูกปิดใช้งาน (ADR-0001). expect 400
# ยิงตรงๆ ตอนนี้ยังไม่ได้: ADM-003 ของ Dev 2 ยัง NotImplemented อยู่
# วิธีเทสชั่วคราว — เปิด `pnpm --dir apps/api exec prisma studio` แล้วตั้ง
# categories.is_active = false ของ {{catCollectibles}} ก่อนยิง block นี้ แล้วตั้งกลับ
# (เคสนี้มีเทสอัตโนมัติคุมอยู่แล้วใน test/auction.e2e-spec.ts)
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "หมวดหมู่ถูกปิด",
  "description": "ต้องได้ Category is not active",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10
}

### validation — ราคาเริ่มต้นต้อง > 0. expect 400
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "ราคาเริ่มต้นเป็นศูนย์",
  "description": "ต้องโดน @IsPositive ปัดตก",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 0,
  "minBidIncrement": 10
}

### validation — ชื่อเรื่องมีแต่ช่องว่าง (Trim แล้วต้องว่าง). expect 400
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "   ",
  "description": "ต้องโดน @Trim + @IsNotEmpty ปัดตก",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10
}

### validation — ยัด field ที่ไม่ได้อยู่ใน DTO เข้ามา. expect 400
# ห้ามให้ client ตั้ง status เองเด็ดขาด — draft ต้องเกิดเป็น DRAFT เสมอ
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "แอบตั้ง status เอง",
  "description": "ต้องโดน forbidNonWhitelisted ปัดตก",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 100,
  "minBidIncrement": 10,
  "status": "ACTIVE"
}

### validation — draft id ที่ไม่ใช่ UUID. expect 400
GET {{baseUrl}}/auctions/drafts/not-a-uuid
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 4. ตรวจสอบก่อนเผยแพร่ (AUC-002)
#=============================================================================
# checklist แบบอ่านอย่างเดียว — ไม่เปลี่ยนสถานะ draft
# ready: true  = ผ่านครบทุกเกณฑ์ พร้อมให้ AUC-004 publish
# ready: false = issues[] บอกว่าเหลืออะไร (field = ชื่อช่องในฟอร์ม ไม่ใช่ชื่อคอลัมน์)

### AUC-002 — draft ที่กรอกครบจาก request ที่ 1. expect 200 + ready: true, issues: []
GET {{baseUrl}}/auctions/drafts/{{draftId}}/validation
Authorization: Bearer {{sellerAToken}}

### AUC-002 — draft ที่ยังไม่มีกำหนดการกับรูป. expect 200 + ready: false
# issues ต้องมี START_AT_REQUIRED, END_AT_REQUIRED, IMAGES_REQUIRED ครบทั้ง 3
# @name draftIncomplete
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "Draft ที่ยังทำไม่เสร็จ",
  "description": "ยังไม่ใส่รูปกับกำหนดการ",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 500,
  "minBidIncrement": 50
}

@incompleteId = {{draftIncomplete.response.body.$.id}}

### AUC-002 — ยิง checklist ของ draft ที่ยังไม่เสร็จ. expect ready: false + 3 issues
GET {{baseUrl}}/auctions/drafts/{{incompleteId}}/validation
Authorization: Bearer {{sellerAToken}}

### AUC-002 — เวลาสิ้นสุดมาก่อนเวลาเริ่ม. expect ready: false + END_AT_NOT_AFTER_START_AT
# @name draftBadSchedule
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "เวลาสลับกัน",
  "description": "เวลาสิ้นสุดมาก่อนเวลาเริ่ม",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 500,
  "minBidIncrement": 50,
  "scheduledStartAt": "2026-09-01T12:00:00.000Z",
  "scheduledEndAt": "2026-09-01T10:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Only"]
}

@badScheduleId = {{draftBadSchedule.response.body.$.id}}

###
GET {{baseUrl}}/auctions/drafts/{{badScheduleId}}/validation
Authorization: Bearer {{sellerAToken}}

### AUC-002 — reserve ต่ำกว่าราคาเริ่มต้น. expect ready: false + RESERVE_BELOW_STARTING_PRICE
# @name draftLowReserve
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "reserve ต่ำกว่าราคาเริ่มต้น",
  "description": "3000 vs 2999",
  "categoryId": "{{catCollectibles}}",
  "condition": "NEW",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 2999,
  "scheduledStartAt": "2026-09-01T10:00:00.000Z",
  "scheduledEndAt": "2026-09-01T12:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Only"]
}

@lowReserveId = {{draftLowReserve.response.body.$.id}}

###
# response ต้องไม่มีเลข 2999 โผล่ออกมาเลย — บอกได้แค่ว่า "ผิดกฎ" (AUC-003)
GET {{baseUrl}}/auctions/drafts/{{lowReserveId}}/validation
Authorization: Bearer {{sellerAToken}}

### AUC-002 — คนอื่นขอดู checklist ของ draft คนอื่น. expect 404
GET {{baseUrl}}/auctions/drafts/{{draftId}}/validation
Authorization: Bearer {{buyerToken}}

### AUC-002 — ไม่ได้ login. expect 401
GET {{baseUrl}}/auctions/drafts/{{draftId}}/validation

### AUC-002 — draft id ที่ไม่ใช่ UUID. expect 400
GET {{baseUrl}}/auctions/drafts/not-a-uuid/validation
Authorization: Bearer {{sellerAToken}}

#=============================================================================
# 5. Preview และ Publish (AUC-004)
#=============================================================================
# preview = อ่านอย่างเดียว ไม่เปลี่ยนสถานะ / publish = เปลี่ยนสถานะจริง
# กติกาสถานะปลายทาง: เวลาเริ่มยังไม่ถึง -> SCHEDULED, ถึงแล้ว -> ACTIVE
#
# ⚠️ วันเวลาในไฟล์นี้ fix ไว้ที่ 2026-09-01 ถ้าวันที่จริงเลยไปแล้ว
#    จะโดน END_AT_IN_THE_PAST ให้แก้เป็นวันในอนาคตก่อนยิง

### AUC-004 preview — เจ้าของดูหน้าตาที่ผู้ซื้อจะเห็น. expect 200
# ต้องไม่มี reservePrice ในผลลัพธ์เด็ดขาด มีแค่ reserveMet (AUC-003)
GET {{baseUrl}}/auctions/drafts/{{draftId}}/preview
Authorization: Bearer {{sellerAToken}}

### AUC-004 preview — ยิงซ้ำแล้วเช็คว่า draft ยังเป็น DRAFT อยู่. expect status: DRAFT
GET {{baseUrl}}/auctions/drafts/{{draftId}}
Authorization: Bearer {{sellerAToken}}

### AUC-004 preview — คนอื่นขอดู preview. expect 404
GET {{baseUrl}}/auctions/drafts/{{draftId}}/preview
Authorization: Bearer {{buyerToken}}

### AUC-004 publish — draft ที่ยังไม่ครบ (ไม่มีรูป/กำหนดการ). expect 400 + issues[]
POST {{baseUrl}}/auctions/drafts/{{incompleteId}}/publish
Authorization: Bearer {{sellerAToken}}

### AUC-004 publish — draft ที่ครบแล้ว เวลาเริ่มยังไม่ถึง. expect 200 + SCHEDULED
# publishedAt ต้องมีค่า, startedAt ต้องเป็น null
POST {{baseUrl}}/auctions/drafts/{{draftId}}/publish
Authorization: Bearer {{sellerAToken}}

### AUC-004 publish — ยิงซ้ำอันเดิม. expect 404
# ไม่ใช่ DRAFT แล้ว จึงหาไม่เจอ — กัน publish ซ้ำโดยไม่ต้องพึ่ง client
POST {{baseUrl}}/auctions/drafts/{{draftId}}/publish
Authorization: Bearer {{sellerAToken}}

### AUC-004 publish — draft ที่เวลาเริ่มถึงแล้ว. expect 200 + ACTIVE
# @name draftStartsNow
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "เริ่มประมูลทันที",
  "description": "เวลาเริ่มอยู่ในอดีต เวลาจบยังมาไม่ถึง",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 1000,
  "minBidIncrement": 50,
  "scheduledStartAt": "2026-08-01T00:00:00.000Z",
  "scheduledEndAt": "2026-12-31T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Live"]
}

@startsNowId = {{draftStartsNow.response.body.$.id}}

###
# startedAt ต้องมีค่าด้วย ไม่ใช่แค่ publishedAt
POST {{baseUrl}}/auctions/drafts/{{startsNowId}}/publish
Authorization: Bearer {{sellerAToken}}

### AUC-004 publish — เวลาจบผ่านไปแล้ว. expect 400 + END_AT_IN_THE_PAST
# @name draftExpired
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "หมดเวลาไปแล้ว",
  "description": "ทั้งเวลาเริ่มและเวลาจบอยู่ในอดีต",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 1000,
  "minBidIncrement": 50,
  "scheduledStartAt": "2026-01-01T00:00:00.000Z",
  "scheduledEndAt": "2026-01-02T00:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Expired"]
}

@expiredId = {{draftExpired.response.body.$.id}}

###
GET {{baseUrl}}/auctions/drafts/{{expiredId}}/validation
Authorization: Bearer {{sellerAToken}}

###
POST {{baseUrl}}/auctions/drafts/{{expiredId}}/publish
Authorization: Bearer {{sellerAToken}}

### AUC-004 publish — คนอื่นสั่ง publish draft ของเรา. expect 404
POST {{baseUrl}}/auctions/drafts/{{startsNowId}}/publish
Authorization: Bearer {{buyerToken}}

### AUC-004 publish — ไม่ได้ login. expect 401
POST {{baseUrl}}/auctions/drafts/{{startsNowId}}/publish

#=============================================================================
# 6. ผู้ซื้อมองเห็นประมูล (AUC-005)
#=============================================================================
# publish แล้ว = สาธารณะทันที ตั้งแต่ SCHEDULED ไม่ต้องรอ ACTIVE
# แต่ biddingOpen จะเป็น true ก็ต่อเมื่อเข้า ACTIVE แล้วเท่านั้น
#
# route นี้เป็น @Public — ยิงได้โดยไม่ต้องมี token
# ถ้าส่ง token มาด้วยและเป็นเจ้าของ จะได้ reservePrice กลับมาเพิ่ม

### AUC-005 — คนไม่ได้ login เปิดดูประมูลที่ publish แล้ว. expect 200
# ต้องไม่มี reservePrice, มีแค่ reserveMet + biddingOpen
GET {{baseUrl}}/auctions/{{draftId}}

### AUC-005 — คนอื่นที่ login อยู่เปิดดู. expect 200 + ยังไม่เห็น reservePrice
GET {{baseUrl}}/auctions/{{draftId}}
Authorization: Bearer {{buyerToken}}

### AUC-005 — เจ้าของเปิดดูประมูลตัวเองหลัง publish. expect 200 + เห็น reservePrice
# หลัง publish แล้ว /auctions/drafts/:id จะหาไม่เจอ (ไม่ใช่ DRAFT แล้ว)
# ทางนี้จึงเป็นทางเดียวที่ผู้ขายยังดู reserve ตัวเองได้
GET {{baseUrl}}/auctions/{{draftId}}
Authorization: Bearer {{sellerAToken}}

### AUC-005 — ประมูลที่ ACTIVE แล้ว. expect 200 + biddingOpen: true
GET {{baseUrl}}/auctions/{{startsNowId}}

### AUC-005 — draft ที่ยังไม่ publish. expect 404
# ต้อง 404 แม้เจ้าของเป็นคนยิงเอง — route นี้ไม่ให้บริการ DRAFT
GET {{baseUrl}}/auctions/{{incompleteId}}
Authorization: Bearer {{sellerAToken}}

### AUC-005 — id ที่ไม่มีอยู่จริง. expect 404
GET {{baseUrl}}/auctions/00000000-0000-4000-8000-0000000099ff

### AUC-005 — id ที่ไม่ใช่ UUID. expect 400
GET {{baseUrl}}/auctions/not-a-uuid

### AUC-005 — เช็คว่า :id ไม่กลืน path `drafts`. expect 401 (ไม่ใช่ 400/404)
# ถ้าเผลอวาง @Get(':id') ไว้เหนือ drafts routes เคสนี้จะพัง
GET {{baseUrl}}/auctions/drafts

#=============================================================================
# 7. แก้ไข / ยกเลิก (AUC-006)
#=============================================================================
# แก้ไขและยกเลิกได้เฉพาะตอน DRAFT หรือ SCHEDULED และต้องยังไม่มีบิด
# พอเป็น ACTIVE แล้ว ข้อมูลหลักแตะไม่ได้อีก — ยกเลิกตอน ACTIVE เป็นงาน admin (ADM-001)
#
# แก้ SCHEDULED จะถูก re-validate ซ้ำด้วยเกณฑ์ AUC-002
# เพราะประมูลที่เผยแพร่ไปแล้วห้ามกลายเป็นข้อมูลไม่ครบ

### AUC-006 — สร้าง draft ไว้ทดลองแก้/ยกเลิก
# @name draftToEdit
POST {{baseUrl}}/auctions/drafts
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "ของทดลองแก้ไข",
  "description": "จะถูกแก้แล้วยกเลิกในบล็อกถัดไป",
  "categoryId": "{{catCollectibles}}",
  "condition": "USED",
  "startingPrice": 3000,
  "minBidIncrement": 100,
  "reservePrice": 4500,
  "scheduledStartAt": "2026-09-01T10:00:00.000Z",
  "scheduledEndAt": "2026-09-01T12:00:00.000Z",
  "imageUrls": ["https://placehold.co/600x400?text=Before"]
}

@editId = {{draftToEdit.response.body.$.id}}

### AUC-006 — แก้ชื่อกับรายละเอียดตอนเป็น DRAFT. expect 200
PATCH {{baseUrl}}/auctions/{{editId}}
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "title": "ชื่อใหม่หลังแก้",
  "description": "รายละเอียดใหม่"
}

### AUC-006 — ส่ง imageUrls ใหม่ = แทนที่ทั้งชุด ไม่ใช่เพิ่มต่อท้าย. expect 200 + images มี 1 รูป
PATCH {{baseUrl}}/auctions/{{editId}}
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "imageUrls": ["https://placehold.co/600x400?text=After"]
}

### AUC-006 — DRAFT แก้ให้ข้อมูลไม่ครบได้ (ลบรูปหมด). expect 200
# draft ยังไม่เผยแพร่ จึงไม่ต้องผ่านเกณฑ์ AUC-002
PATCH {{baseUrl}}/auctions/{{editId}}
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{
  "imageUrls": []
}

