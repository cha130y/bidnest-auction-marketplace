###############################################################################
# CHAT — a chat room is tied to "1 product + 1 buyer" (CHAT-001)
# Messages are plain text only in V1 — no files/images (CHAT-002)
# Admins can't read them — private between the participants (SRS 6)
###############################################################################

@baseUrl = http://localhost:4000

# AUTH-008 — MockAuthGuard has been removed; every request needs a real bearer token
# Run the seed, then copy the @xToken lines it prints and paste them here
# (they expire per JWT_ACCESS_TTL, 15 minutes by default — once you start getting 401, seed again)
@buyerToken =
@sellerAToken =

@productA1 = 00000000-0000-4000-8000-000000000201

### CHAT-001 open a chat room from the product page. expect 201
# Calling again must return the same room (same id), not create a new one
# @name openConversation
POST {{baseUrl}}/products/{{productA1}}/conversations
Authorization: Bearer {{buyerToken}}

@conversationId = {{openConversation.response.body.$.id}}

### CHAT-001 call again — must return the same id as above. expect 201
POST {{baseUrl}}/products/{{productA1}}/conversations
Authorization: Bearer {{buyerToken}}

### CHAT-002 buyer sends a message. expect 201
# The server log must show "[stub] message:sent -> conversation:..."
POST {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "body": "I'm interested. How low can you go?" }

### CHAT-002 seller replies. expect 201
POST {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{sellerAToken}}
Content-Type: application/json

{ "body": "I can go down to 2,000." }

### CHAT-003 read messages in the room (buyer view). expect 200
GET {{baseUrl}}/conversations/{{conversationId}}/messages
Authorization: Bearer {{buyerToken}}

### CHAT-003 read messages with pagination
GET {{baseUrl}}/conversations/{{conversationId}}/messages?page=1&limit=10
Authorization: Bearer {{buyerToken}}

### CHAT-003 buyer's inbox. expect 200
GET {{baseUrl}}/conversations
Authorization: Bearer {{buyerToken}}

### CHAT-003 seller's inbox — must show the same room. expect 200
GET {{baseUrl}}/conversations
Authorization: Bearer {{sellerAToken}}
