# Copy this file to .env.local and fill in your local values.

# Base URL of apps/api (see apps/api/.env.example PORT).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# NextAuth (Auth.js) signs the session cookie with this — required, the app
# will not start without it. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Auth.js refuses to trust the Host header unless told to — it is what stops a
# spoofed header from redirecting a sign-in somewhere else. Vercel sets this
# automatically; a self-hosted deployment (and `next start` locally) has to say
# so, and must only say so when something in front of it validates the host.
AUTH_TRUST_HOST=true
