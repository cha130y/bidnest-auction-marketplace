# Copy this file to .env.local and fill in your local values.

# Base URL of apps/api (see apps/api/.env.example PORT).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# NextAuth (Auth.js) signs the session cookie with this — required, the app
# will not start without it. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Auth.js refuses to trust the Host header unless told to — it is what stops a
# spoofed header from redirecting a sign-in somewhere else. Vercel sets this
# automatically; a self-hosted deployment (and `next start` locally) has to say
# so, and must only say so when something in front of it validates the host.
AUTH_TRUST_HOST=true

# This site's own public origin. Behind a proxy the request's URL is the
# internal one, and Line compares the redirect_uri it was given at authorize
# time against the one sent at token time, byte for byte — so it is read from
# here first. Leave it out locally and the request's own origin is used.
AUTH_URL="http://localhost:3000"

# --- AUTH-003: Google sign-in -------------------------------------------
# console.cloud.google.com -> Credentials -> OAuth client ID (Web application)
# Add http://localhost:3000 under "Authorized JavaScript origins".
#
# The same client ID as apps/api's GOOGLE_CLIENT_ID: this side obtains the
# token, that side verifies the audience matches. NEXT_PUBLIC_ because the
# browser needs it, and safe there — a client ID is public by design. There is
# deliberately no client secret here: Google Identity Services hands the ID
# token straight to the page, so none is involved on this path at all.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- AUTH-006: Line sign-in ---------------------------------------------
# developers.line.biz -> LINE Login channel -> Basic settings
# Add http://localhost:3000/api/auth/line/callback under "Callback URL".
#
# Unlike Google, Line only returns an authorization code, and redeeming it
# needs the secret — so this flow runs server-side and the secret must never
# be NEXT_PUBLIC_. Leave LINE_CHANNEL_ID empty and the button is hidden rather
# than shown broken.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
